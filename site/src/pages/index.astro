---
import Base from '../layouts/Base.astro';
import StatStrip from '../components/StatStrip.astro';
import PairCard from '../components/PairCard.astro';
import m from '../data/manifest.json';

function fmtBig(n: string | number) {
  const v = typeof n === 'string' ? parseInt(n) : n;
  if (v >= 1_000_000_000) return (v / 1_000_000_000).toFixed(1) + 'B';
  if (v >= 1_000_000) return (v / 1_000_000).toFixed(1) + 'M';
  if (v >= 1_000) return (v / 1_000).toFixed(1) + 'K';
  return v.toString();
}

// Popular order: flagship cities first, then by volume
const popularOrder = ['kyiv', 'chornobyl', 'odesa', 'lviv', 'kharkiv', 'donbas', 'luhansk', 'dnipro', 'zaporizhzhia', 'volodymyr-zelenskyy', 'oleksandr-usyk', 'bakhmut'];
const allPairs = m.pairs.filter((p: any) => !p.is_control);
const pairs = [
  ...popularOrder.map(s => allPairs.find((p: any) => p.slug === s)).filter(Boolean),
  ...allPairs.filter((p: any) => !popularOrder.includes(p.slug)).sort((a: any, b: any) => (b.total || 0) - (a.total || 0)),
];

const stats = [
  // "90B+ records scanned" was a hardcoded string, not a measurement, and
  // "300.3M toponym matches" summed every source's record field regardless of unit
  // — 99.5% of it was Wikipedia PAGEVIEWS counted as textual matches. Both removed
  // rather than restated; the remaining figures are each directly verifiable.
  { value: String(m.analyzable_pairs), label: 'pairs tracked' },
  { value: String(m.num_sources), label: 'data sources' },
  { value: m.time_span, label: 'time span' },
];
---

<Base activeNav="home">

<!-- Hero -->
<div class="hero">
  <img src="/logo.svg" alt="Kyiv chestnut" class="hero-logo">
  <div>
    <h1 class="heading-xl">#KyivNotKiev</h1>
    <p class="subtitle">
      In 2018, Ukraine's foreign ministry <a href="https://en.wikipedia.org/wiki/KyivNotKiev" target="_blank">launched a campaign</a> to change
      how the world spells Ukrainian place names. This is a computational audit of that adoption — large-scale data analysis and machine learning across {m.num_sources} independent sources.
    </p>
  </div>
</div>

<div class="mb-lg">
  <StatStrip items={stats} />
</div>

<!-- Data sources, as one compact sentence. Driven from manifest.sources so the
     list, colours and count cannot drift from what the pipeline produced. Named
     colour marks rather than brand logos: nothing external to fetch, so it cannot
     break offline, and no third-party trademarks are reproduced. -->
<p class="source-line mb-lg">
  Data is collected from {m.num_sources} sources:{' '}
  {Object.entries(m.sources).map(([key, s]: any, i: number) => (
    <>
      <a class="src-mark" href={`/sources#${key}`} style={`--c: ${s.color}`}
         title={`${s.label} — ${fmtBig(s.records)} ${s.unit}`}>
        <span class="src-dot"></span>{s.label}
      </a>{i < Object.keys(m.sources).length - 1 ? ', ' : ''}
    </>
  ))}
  {' '}covering {m.time_span}.
</p>

<style>
  .source-line {
    font-size: 0.9rem; line-height: 1.9; color: var(--text-muted, #6b7280);
  }
  .src-mark {
    display: inline-flex; align-items: center; gap: 0.28rem;
    padding: 0.1rem 0.42rem; border-radius: 999px;
    border: 1px solid #e5e7eb; background: #fff;
    color: var(--text, #111); text-decoration: none;
    font-weight: 600; font-size: 0.84rem; white-space: nowrap;
  }
  .src-mark:hover { border-color: var(--c); text-decoration: none; }
  .src-dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--c); flex: 0 0 auto;
  }
</style>

<!-- Sort + Filter -->
<div class="controls-bar mb-md">
  <div class="controls-group">
    <span class="controls-label">Sort</span>
    <button class="ctrl-btn active" data-sort="popular">Popular</button>
    <button class="ctrl-btn" data-sort="volume">Volume</button>
    <button class="ctrl-btn" data-sort="adoption">Adoption</button>
    <button class="ctrl-btn" data-sort="alpha">A-Z</button>
  </div>
</div>

<!-- Pair cards -->
<div id="pair-grid" class="grid-auto">
  {pairs.map((p: any, i: number) => (
    <PairCard
      slug={p.slug}
      russian={p.russian}
      ukrainian={p.ukrainian}
      adoption={p.adoption || 0}
      total={p.total || 0}
      popularRank={i}
    />
  ))}
</div>

<!-- Footer -->
<div class="page-footer">
  <p>
    Built by <a href="https://github.com/IvanDobrovolsky" target="_blank">Ivan Dobrovolsky</a>.
    Dataset and model on <a href="https://huggingface.co/KyivNotKiev" target="_blank">Hugging Face</a>.
    <a href="https://www.bbc.com/ukrainian/news-45718643" target="_blank">BBC Ukraine coverage</a>.
    <a href="/privacy.html">Privacy Policy</a>.
  </p>
</div>

<script>
  const grid = document.getElementById('pair-grid')!;
  const cards = Array.from(grid.querySelectorAll('.pair-card')) as HTMLElement[];

  document.querySelectorAll('[data-sort]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-sort]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const mode = (btn as HTMLElement).dataset.sort;
      [...cards].sort((a, b) => {
        if (mode === 'popular') return (Number(a.dataset.popular) || 0) - (Number(b.dataset.popular) || 0);
        if (mode === 'volume') return (Number(b.dataset.total) || 0) - (Number(a.dataset.total) || 0);
        if (mode === 'adoption') return (Number(b.dataset.adoption) || 0) - (Number(a.dataset.adoption) || 0);
        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      }).forEach(c => grid.appendChild(c));
    });
  });

</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-xl) 0 var(--space-md);
  }
  .hero-logo {
    height: 80px;
    width: auto;
    flex-shrink: 0;
  }
  .page-footer {
    margin-top: var(--space-xl);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--border);
    font-size: 0.87rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .page-footer p { margin: 0 0 0.4rem; }
</style>

</Base>
