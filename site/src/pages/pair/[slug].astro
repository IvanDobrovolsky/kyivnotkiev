            <td style="padding:0.4rem 0.6rem; font-size:0.8rem;"><a href="${articleUrl}" target="_blank" rel="noopener" style="color:var(--text); font-weight:500; text-decoration:none; border-bottom:1px dotted #d1d5db;">${domain}</a>${tag}</td>
