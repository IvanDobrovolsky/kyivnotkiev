---
import Base from '../../layouts/Base.astro';
import PairView from '../../components/PairView.astro';
import m from '../../data/manifest.json';
import llmTraj from '../../data/llm_trajectory.json';
import llmPerPair from '../../data/llm_per_pair.json';
// Removed 2026-08-29: computed from the corpus before the GDELT (26 Aug), trends (28 Aug)
// and YouTube rebuilds, so it stated findings the current data no longer supports.
// Empty rather than deleted inline so the render guards hide the section.
import allClClusters from '../../data/cl_clusters.json';   // regenerated by the stats pipeline
import allHoldoutsByPair from '../../data/holdouts_by_pair.json';
import allTimeseries from '../../data/timeseries.json';

export function getStaticPaths() {
  const manifest = m as any;
  return manifest.pairs
    .filter((p: any) => !p.is_control)
    .map((p: any) => ({
      params: { slug: p.slug },
      props: { pair: p },
    }));
}

const { pair } = Astro.props;
const slug = pair.slug;
const title = `${pair.russian} → ${pair.ukrainian} — #KyivNotKiev`;
const pairClusterData = (allClClusters as any)?.[slug] || null;
const pairHoldoutsRaw = (allHoldoutsByPair as any)?.[slug] || null;
// Trim news_articles: cap at 500, truncate text_preview to save bandwidth
const pairHoldoutsData = pairHoldoutsRaw ? {
  ...pairHoldoutsRaw,
  news_articles: (pairHoldoutsRaw.news_articles || []).slice(0, 500).map((a: any) => ({
    domain: a.domain, url: a.url, variant: a.variant, month: a.month,
    text_preview: (a.text_preview || '').slice(0, 120),
  })),
  _total_articles: (pairHoldoutsRaw.news_articles || []).length,
} : null;
const pairTimeseriesData = { events: (allTimeseries as any)?.events || [], [slug]: (allTimeseries as any)?.[slug] || null };
---

<Base title={title}>

<div class="flex items-center gap-sm mb-md">
  <a href="/" class="link text-sm">&larr; All pairs</a>
</div>

<script type="application/json" id="pair-route-data" set:html={JSON.stringify({ slug: pair.slug, russian: pair.russian, ukrainian: pair.ukrainian })} />
<script type="application/json" id="pair-cluster-data" set:html={JSON.stringify(pairClusterData)} />
<script type="application/json" id="pair-holdouts-data" set:html={JSON.stringify(pairHoldoutsData)} />
<script type="application/json" id="pair-timeseries-data" set:html={JSON.stringify(pairTimeseriesData)} />
<div id="pair-detail" data-pair-slug={slug}>
  <PairView llmTraj={llmTraj} llmPerPair={llmPerPair} timeSpan={(m as any).time_span} />
</div>

  <script>
    import * as d3 from 'd3';
    const timeseriesData = JSON.parse(document.getElementById('pair-timeseries-data')?.textContent || '{}');
    import manifest from '../../data/manifest.json';
    const holdoutsByPair = { [document.getElementById('pair-detail')!.dataset.pairSlug!]: JSON.parse(document.getElementById('pair-holdouts-data')?.textContent || 'null') };
    import pairEvents from '../../data/pair_events.json';
    // trends_countries removed — using GDELT country distribution only
    const errorAnalysis: any = {};
    const clCollocations: any = {};
    const clAnalysis: any = {};
    const clClusters = { [document.getElementById('pair-detail')!.dataset.pairSlug!]: JSON.parse(document.getElementById('pair-cluster-data')?.textContent || 'null') };
    const confusionMatrix: any = {};
    import analysisData from '../../data/analysis.json';

    // Use manifest as the single pairs source
    const pairs = { pairs: manifest.pairs };

    let cachedWorld: any = null;

    const sourceColors: Record<string, string> = {
      trends: '#4285F4',
      gdelt: '#1e3a5f',
      wikipedia: '#636466',
      reddit: '#FF4500',
      youtube: '#FF0000',
      ngrams: '#7c3aed',
      openalex: '#06b6d4',
      telegram: '#26A5E4',
    };

    const sourceLabels: Record<string, string> = {
      gdelt: 'News',
      trends: 'Trends',
      wikipedia: 'Wiki',
      reddit: 'Reddit',
      youtube: 'YouTube',
      ngrams: 'Books',
      openalex: 'Academic',
      telegram: 'Telegram',
    };

    // Read source from URL params for shareable links
    const _urlSource = new URLSearchParams(window.location.search).get('source');
    const validSources = ['trends','gdelt','wikipedia','reddit','youtube','ngrams','openalex','telegram'];
    // The default comes from config/pairs.yaml via the manifest, so it is set in one
    // place. It used to be hardcoded here, in the Ukrainian landing page, and again
    // in the button markup — which drifted apart: the default named one source while
    // the highlighted button showed another.
    const _cfgDefault = (manifest as any).default_source || 'trends';
    let activeSource = _urlSource && validSources.includes(_urlSource)
      ? _urlSource
      : (validSources.includes(_cfgDefault) ? _cfgDefault : 'trends');
    let activeSources = new Set([activeSource]);
    // Keep the highlighted button in step with the resolved default.
    document.querySelectorAll('.source-toggle').forEach((b) => {
      b.classList.toggle('active', (b as HTMLElement).dataset.source === activeSource);
    });
    // hideRuDomains replaced by holdoutFilter
    let lineMode: 'both' | 'ukrainian' | 'russian' = 'both';
    let chartMode: 'adoption' | 'volume' = 'volume';
    let showEvents = true;

    // No query params needed — slug is in the URL path (/pair/kyiv)

    function showView(mode: 'landing' | 'pair') {
      const landing = document.getElementById('landing-view');
      const global = document.getElementById('global-view');
      const pair = document.getElementById('pair-view');
      const main = document.querySelector('.main') as HTMLElement;
      if (landing) landing.style.display = mode === 'landing' ? 'block' : 'none';
      if (global) global.style.display = mode === 'landing' ? 'block' : 'none';
      if (pair) pair.style.display = mode === 'pair' ? 'block' : 'none';
      // Fade in on first render
      if (main) main.style.opacity = '1';
    }

    function renderTop6Cards() {
      const topPairs = [...(pairs as any).pairs]
        .filter((p: any) => !p.is_control)
        .sort((a: any, b: any) => (b.total || 0) - (a.total || 0))
        .slice(0, 6);
      const grid = document.getElementById('top6-grid');
      if (!grid) return;
      grid.innerHTML = '';
      topPairs.forEach((p: any) => {
        const id = p.slug;
        const desc = `${(p.total || 0).toLocaleString()} matches`;
        const pct = p.adoption;
        const color = pct >= 55 ? '#059669' : pct >= 25 ? '#d97706' : '#dc2626';
        const coll = (clCollocations as any)?.[String(id)];
        const card = document.createElement('div');
        card.className = 'top6-card';
        card.dataset.pairSlug = p.slug;
        card.style.cssText = 'cursor:pointer; padding:0.75rem; border:1px solid var(--border); border-radius:8px; transition:all 0.15s;';

        // Header + adoption
        let html = `
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:0.5rem;">
            <div style="font-weight:600; color:var(--text); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${p.russian} → ${p.ukrainian}</div>
            <div style="font-size:0.8rem; font-weight:700; color:${color}; flex-shrink:0;">${pct}%</div>
          </div>
          <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.15rem;">${desc}</div>
          <div style="height:3px; background:#f0f0f0; border-radius:2px; margin-top:0.3rem; margin-bottom:0.4rem;"><div style="height:100%; width:${pct}%; background:${color}; border-radius:2px;"></div></div>`;

        // Collocations inline
        if (coll) {
          for (const [variant, vcolor, label] of [['russian', '#dc2626', 'RU'], ['ukrainian', '#2563eb', 'UA']]) {
            const words = coll[variant]?.collocates?.slice(0, 5) || [];
            if (!words.length) continue;
            const maxC = Math.max(...words.map((w: any) => w.count));
            html += `<div style="margin-bottom:0.2rem;"><span style="font-size:0.76rem;color:${vcolor};font-weight:700;text-transform:uppercase;letter-spacing:0.04em;margin-right:0.25rem;">${label}</span>`;
            words.forEach((w: any, i: number) => {
              const sz = 0.68 + (w.count / maxC) * 0.3;
              const fw = i < 2 ? 700 : 400;
              html += `<span style="font-size:${sz}rem;color:${vcolor};font-weight:${fw};margin-right:0.25rem;">${w.word}</span>`;
            });
            html += `</div>`;
          }
        }

        card.innerHTML = html;
        card.addEventListener('click', () => {
          selectPair(id);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        card.addEventListener('mouseenter', () => { card.style.borderColor = '#0057B8'; card.style.boxShadow = '0 2px 8px rgba(0,87,184,0.1)'; });
        card.addEventListener('mouseleave', () => { card.style.borderColor = '#e5e7eb'; card.style.boxShadow = 'none'; });
        grid.appendChild(card);
      });
    }

    function showLanding() {
      activePairSlug = '';
      showView('landing');
      document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
      renderTop6Cards();
      drawHeatmap();
      drawErrorAnalysis();
      requestAnimationFrame(() => {
        drawClContextChart();
        drawClBenchmark();
      });
    }

    // Pair detail page: ID is guaranteed by getStaticPaths
    const _routeData = JSON.parse(document.getElementById('pair-route-data')!.textContent!);
    let activePairSlug = _routeData.slug;

    const infoEl2 = document.getElementById('chart-info');
    const sourceInfo2: Record<string, string> = {
      trends: 'Google search interest — relative, normalized 0–100',
      gdelt: 'Verified articles from active news media',
      wikipedia: 'Wikipedia page views',
      reddit: 'Reddit user posts',
      youtube: 'YouTube videos naming the spelling in title or description',
      ngrams: 'Word frequency in printed books (Google Books)',
      openalex: 'Academic papers (OpenAlex)',
      telegram: 'Public Telegram channel messages',
    };

    function drawChart() {
      const container = document.getElementById('chart')!;
      const legendContainer = document.getElementById('chart-legend')!;

      // Fade out, redraw, fade in
      container.style.opacity = '0';
      container.style.transition = 'opacity 0.15s ease';
      container.innerHTML = '';
      legendContainer.innerHTML = '';

      requestAnimationFrame(() => {
        container.style.opacity = '1';
      });

      const rect = container.getBoundingClientRect();
      const margin = { top: 30, right: 10, bottom: 28, left: 45 };
      const width = rect.width - margin.left - margin.right;
      const height = rect.height - margin.top - margin.bottom;

      const svg = d3.select('#chart')
        .append('svg')
        .attr('viewBox', `0 0 ${rect.width} ${rect.height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      const pairData = (timeseriesData as any)[activePairSlug];
      if (!pairData) {
        svg.append('text')
          .attr('x', width / 2).attr('y', height / 2)
          .attr('text-anchor', 'middle')
          .attr('fill', '#9ca3af')
          .attr('font-size', '14px')
          .text('No data available for this pair');
        return;
      }

      // Check if active source has data for this pair
      const hasData = activeSources.size > 0 && [...activeSources].some(s => pairData[s] && pairData[s].length > 0);
      if (!hasData) {
        // Styled "insufficient data" message
        const g = svg.append('g')
          .attr('transform', `translate(${width / 2}, ${height / 2 - 20})`);
        g.append('text')
          .attr('text-anchor', 'middle')
          .attr('fill', '#6b7280')
          .attr('font-size', '15px')
          .attr('font-weight', '500')
          .text(`Insufficient ${sourceLabels[activeSource] || activeSource} data`);
        g.append('text')
          .attr('y', 24)
          .attr('text-anchor', 'middle')
          .attr('fill', '#9ca3af')
          .attr('font-size', '12px')
          .text('Not enough mentions to produce a reliable chart');
        g.append('text')
          .attr('y', 46)
          .attr('text-anchor', 'middle')
          .attr('fill', '#d1d5db')
          .attr('font-size', '11px')
          .text('Try News, Trends, or Books for broader coverage');
        // Subtle icon
        g.append('text')
          .attr('y', -30)
          .attr('text-anchor', 'middle')
          .attr('fill', '#e5e7eb')
          .attr('font-size', '28px')
          .text('◯');
        return;
      }

      const parseDate = d3.timeParse('%Y-%m');
      const allDates: Date[] = [];

      for (const src of activeSources) {
        const series = pairData[src];
        if (!series) continue;
        for (const d of series) {
          const date = parseDate(d.date);
          if (date) allDates.push(date);
        }
      }

      // Subtitle and mode chrome update BEFORE any early return: switching to a
      // source with no data used to bail out up here and leave the previous
      // source's description ("Reddit user posts") stuck on screen.
      if (infoEl2) infoEl2.textContent = sourceInfo2[activeSource] || '';
      if (allDates.length === 0) return;

      // Dynamic range based on actual data for this pair + source
      const seriesData = pairData[activeSource] || [];
      const dataMinDate = d3.min(allDates) as Date;
      const dataMaxDate = d3.max(allDates) as Date;

      // Tight fit — minimal padding so bars fill the chart, clamped to the study
      // period. The data runs 2010-01 to 2025-12; padding a month past the last
      // point pushed the axis into 2026 and rendered a year with no data in it.
      const STUDY_START = new Date(2010, 0, 1);
      const STUDY_END = new Date(2025, 11, 31);
      // The x axis is the whole study period for every source, never the active
      // source's own extent. Sources begin at different times -- GDELT has nothing
      // before 2015 -- and rescaling the axis per source made series covering
      // different years look aligned, which defeats comparing them. Spans a source
      // does not cover are hatched below, so an absence reads as an absence rather
      // than as a flat line at zero.
      const xStart = STUDY_START;
      const xEnd = STUDY_END;
      const x = d3.scaleTime()
        .domain([xStart, xEnd])
        .range([0, width]);

      // Update title range and info text
      const rangeEl = document.getElementById('chart-range');
      const infoEl = infoEl2;
      const sourceInfo = sourceInfo2;
      // The date range label is gone: the x axis is pinned to the study period on
      // every source, so the axis already says it.
      if (rangeEl) rangeEl.textContent = '';
      if (infoEl) infoEl.textContent = sourceInfo[activeSource] || '';

      // Y-axis depends on chart mode
      let y: d3.ScaleLinear<number, number>;
      let yTicks: number[];

      if (chartMode === 'volume') {
        const getVal = (d: any) => {
          if (lineMode === 'ukrainian') return d.ukr || 0;
          if (lineMode === 'russian') return d.rus || 0;
          return Math.max(d.ukr || 0, d.rus || 0);
        };
        const allVals = (seriesData || []).map(getVal).filter((v: number) => v > 0);
        const maxVal = allVals.length > 0 ? Math.max(...allVals) : 1;

        // Check if data is lopsided (>20x ratio between UA and RU)
        const maxUkr = Math.max(...(seriesData || []).map((d: any) => d.ukr || 0), 1);
        const maxRus = Math.max(...(seriesData || []).map((d: any) => d.rus || 0), 1);
        const ratio = Math.max(maxUkr, maxRus) / Math.min(maxUkr, maxRus);
        const useSym = ratio > 20 && lineMode === 'both';

        if (useSym) {
          // Symlog constant sets where the scale stops being linear. It was fixed at
          // 100, which on a 0-110 domain kept everything linear and hid the smaller
          // variant entirely — calibrated trends put Chornobyl at 0.9 against
          // Chernobyl's 100. Derive it from the smallest positive value instead, so
          // the compression matches the actual spread.
          const positives = (seriesData || [])
            .flatMap((d: any) => [d.ukr || 0, d.rus || 0])
            .filter((v: number) => v > 0);
          const minPos = positives.length ? Math.min(...positives) : 1;
          y = d3.scaleSymlog().constant(Math.max(minPos, maxVal / 1e4))
                .domain([0, maxVal * 1.1]).range([height, 0]) as any;
          const yMax = maxVal * 1.1;
          const rnd = (v: number) => v >= 10 ? Math.round(v) : Math.round(v * 100) / 100;
          yTicks = [0, rnd(yMax * 0.001), rnd(yMax * 0.01), rnd(yMax * 0.1), rnd(yMax)];
        } else {
          const yMax = maxVal * 1.1;
          y = d3.scaleLinear().domain([0, yMax]).range([height, 0]);
          const step = yMax / 4;
          yTicks = [0, step, step * 2, step * 3, yMax].map(v => Math.round(v));
        }
      } else {
        // The adoption axis scales to the active source rather than always spanning
        // 0-100%. chornobyl trends peaks at 15.3% with a median of 0.18%, which on a
        // fixed 0-100% axis is a flat line along the bottom and reads as "no data"
        // instead of as a small but real share. Sources are scaled independently so
        // each one's shape is legible; the axis label carries the level.
        const adVals = (seriesData || [])
          .map((d: any) => d.adoption)
          .filter((v: any) => v !== null && v !== undefined && !isNaN(v));
        const adMax = adVals.length ? Math.max(...adVals) : 100;
        const yMax = adMax >= 60 ? 100 : Math.min(100, Math.max(adMax * 1.2, 1));
        y = d3.scaleLinear().domain([0, yMax]).range([height, 0]);
        const st = yMax / 4;
        const rnd = (v: number) => yMax >= 20 ? Math.round(v) : Math.round(v * 100) / 100;
        yTicks = [0, rnd(st), rnd(st * 2), rnd(st * 3), rnd(yMax)];
      }

      // Grid lines
      svg.append('g').selectAll('line')
        .data(yTicks)
        .enter().append('line')
        .attr('x1', 0).attr('x2', width)
        .attr('y1', (d: number) => y(d)).attr('y2', (d: number) => y(d))
        .attr('stroke', '#e5e7eb')
        .attr('stroke-dasharray', '3,4');

      // ── No-data regions ──────────────────────────────────────────────────
      // Hatch every span the active source does not cover. The gap threshold is
      // derived from the source's own median cadence rather than a fixed number of
      // days, because sources differ: ngrams is yearly, the rest monthly, and a
      // fixed threshold would mark all of ngrams as missing.
      const defs = svg.append('defs');
      defs.append('pattern')
        .attr('id', 'nodata-hatch')
        .attr('patternUnits', 'userSpaceOnUse')
        .attr('width', 6).attr('height', 6)
        .attr('patternTransform', 'rotate(45)')
        .append('line')
        .attr('x1', 0).attr('y1', 0).attr('x2', 0).attr('y2', 6)
        .attr('stroke', '#cbd5e1').attr('stroke-width', 2);

      const covDates = (seriesData || [])
        .map((d: any) => parseDate(d.date))
        .filter((d: any) => !!d)
        .sort((a: any, b: any) => a.getTime() - b.getTime());

      const gapSpans: [Date, Date][] = [];
      if (covDates.length === 0) {
        gapSpans.push([xStart, xEnd]);
      } else {
        const deltas: number[] = [];
        for (let i = 1; i < covDates.length; i++) {
          deltas.push(covDates[i].getTime() - covDates[i - 1].getTime());
        }
        deltas.sort((a, b) => a - b);
        const med = deltas.length ? deltas[Math.floor(deltas.length / 2)] : 31 * 864e5;
        // Only the span OUTSIDE a source's coverage is missing data. A month with no
        // point INSIDE the covered range is a measured zero, not an unobserved month:
        // the export drops rows where ukr+rus is 0, and Reddit was crawled
        // continuously from 2010, so "nobody mentioned ihor-sikorsky in March 2013"
        // was being hatched as "we never looked". That produced 258 false interior
        // bands across the pairs, densest on exactly the sparse pairs where reading
        // the chart correctly matters most.
        //
        // A point also stands for its whole period, so coverage runs one cadence past
        // the last point — otherwise a monthly series ending 2025-12-01 left a sliver
        // hatched against an axis ending 2025-12-31 on every chart, covered or not.
        if (covDates[0].getTime() > xStart.getTime()) gapSpans.push([xStart, covDates[0]]);
        // A point covers its whole period, so coverage runs one cadence past the last
        // point and the hatch starts there. Hatching from the point itself would mark
        // a covered period as missing — ngrams' 2022-01 point covers all of 2022.
        // The blank strip this leaves on yearly sources is closed by extending the
        // plotted area instead (see seriesForPlot below), not by moving the hatch.
        const lastCovered = covDates[covDates.length - 1].getTime() + med;
        if (lastCovered < xEnd.getTime()) gapSpans.push([new Date(lastCovered), xEnd]);
        (window as any).__lastCadenceMs = med;
      }

      const gapG = svg.append('g').attr('class', 'nodata-regions');
      for (const [ga, gb] of gapSpans) {
        const gx0 = Math.max(0, x(ga));
        const gx1 = Math.min(width, x(gb));
        if (gx1 - gx0 < 3) continue;
        gapG.append('rect')
          .attr('x', gx0).attr('y', 0)
          .attr('width', gx1 - gx0).attr('height', height)
          .attr('fill', 'url(#nodata-hatch)').attr('opacity', 0.5);
        gapG.append('rect')
          .attr('x', gx0).attr('y', 0)
          .attr('width', gx1 - gx0).attr('height', height)
          .attr('fill', 'none').attr('stroke', '#cbd5e1')
          .attr('stroke-width', 1).attr('stroke-dasharray', '4,3');
        if (gx1 - gx0 >= 46) {
          const cx = (gx0 + gx1) / 2;
          const vertical = (gx1 - gx0) < 96;
          gapG.append('text')
            .attr('x', cx).attr('y', height / 2)
            .attr('text-anchor', 'middle').attr('dominant-baseline', 'middle')
            .attr('font-size', 12).attr('fill', '#94a3b8')
            .attr('transform', vertical ? `rotate(-90 ${cx} ${height / 2})` : null)
            .text('no data');
        }
      }

      // Y-axis labels — same ticks as grid
      const fmtY = (d: number) => {
        if (chartMode === 'volume') {
          if (d >= 1e6) return (d / 1e6).toFixed(1) + 'M';
          if (d >= 1e3) return (d / 1e3).toFixed(0) + 'K';
          return d === 0 ? '0' : String(Math.round(d));
        }
        return d + '%';
      };
      svg.append('g').selectAll('text')
        .data(yTicks)
        .enter().append('text')
        .attr('x', -8).attr('y', (d: number) => y(d) + 4)
        .attr('text-anchor', 'end')
        .attr('fill', '#9ca3af').attr('font-size', '10px')
        .text(fmtY);

      // X-axis — decades for Ngrams, years for others
      const xTicks = d3.axisBottom(x).ticks(d3.timeYear.every(1)).tickSize(0).tickPadding(8).tickFormat(d3.timeFormat('%Y') as any);

      svg.append('g')
        .attr('transform', `translate(0,${height})`)
        .call(xTicks)
        .selectAll('text').attr('fill', '#9ca3af').attr('font-size', '12px');

      svg.selectAll('.domain').attr('stroke', '#e5e7eb');

      // Event markers — positioned by date on x-scale
      if (showEvents) {
        const globalEvents = ((timeseriesData as any).events || []).map((e: any) => ({...e, type: 'global'}));
        const customEvents = ((pairEvents as any)[activePairSlug] || []).map((e: any) => ({...e, type: 'pair'}));
        const events = [...globalEvents, ...customEvents].sort((a: any, b: any) => a.date.localeCompare(b.date));

        let eventNum = 0;
        events.forEach((evt: any) => {
          const date = parseDate(evt.date);
          if (!date || date < xStart || date > xEnd) return;
          eventNum++;
          const xPos = x(date);
          const isPair = evt.type === 'pair';

          // Vertical dashed line
          svg.append('line')
            .attr('x1', xPos).attr('x2', xPos)
            .attr('y1', -10).attr('y2', height)
            .attr('stroke', isPair ? '#0057B8' : '#d1d5db')
            .attr('stroke-width', 1)
            .attr('stroke-dasharray', '4,3')
            .attr('opacity', isPair ? 0.5 : 0.3);

          // Numbered circle at top. Hovering it pulses the matching legend entry.
          // `eventNum` is a shared mutable counter, so the handlers must capture
          // this iteration's value — closing over the variable made every badge
          // pulse only the last event's legend row.
          const thisNum = eventNum;
          svg.append('circle')
            .attr('cx', xPos).attr('cy', -18)
            .attr('r', 9)
            .attr('fill', isPair ? '#0057B8' : '#e5e7eb')
            .style('cursor', 'default')
            .on('mouseenter', () => {
              const el = document.querySelector(`[data-event-legend="${thisNum}"]`);
              if (el) { el.classList.remove('evt-pulse'); void (el as HTMLElement).offsetWidth; el.classList.add('evt-pulse'); }
            })
            .on('mouseleave', () => {
              document.querySelector(`[data-event-legend="${thisNum}"]`)?.classList.remove('evt-pulse');
            });
          // Two-digit numbers crowd the circle at a fixed size, so the type steps down
          // once the label reaches double digits. Centred on the baseline rather than
          // by a hand-tuned y offset, which drifted as the size changed.
          svg.append('text')
            .attr('x', xPos).attr('y', -18)
            .attr('text-anchor', 'middle')
            .attr('dominant-baseline', 'central')
            .attr('fill', isPair ? '#fff' : '#6b7280')
            .attr('font-size', String(eventNum).length > 1 ? '8px' : '9.5px')
            .attr('font-weight', '600')
            .attr('letter-spacing', '-0.02em')
            .text(eventNum);

          // Legend entry below chart
          const legendItem = document.createElement('span');
          legendItem.className = 'legend-item';
          legendItem.setAttribute('data-event-legend', String(eventNum));
          legendItem.style.cssText = `font-size:0.87rem; color:${isPair ? '#0057B8' : '#6b7280'}; ${isPair ? 'font-weight:600;' : ''}`;
          legendItem.innerHTML = `<span style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:${isPair ? '#0057B8' : '#e5e7eb'};color:${isPair ? '#fff' : '#6b7280'};font-size:12px;font-weight:700;margin-right:4px;">${eventNum}</span>${evt.label} (${evt.date})`;
          legendContainer.appendChild(legendItem);
        });
      }

      // Wikipedia rename annotation
      if (activeSources.has('wikipedia') && pairData.wikipedia_rename) {
        const renameDate = parseDate(pairData.wikipedia_rename);
        if (renameDate && renameDate >= xStart && renameDate <= xEnd) {
          const rx = x(renameDate);
          // Solid orange line
          svg.append('line')
            .attr('x1', rx).attr('x2', rx)
            .attr('y1', -5).attr('y2', height)
            .attr('stroke', '#d97706')
            .attr('stroke-width', 1.5)
            .attr('stroke-dasharray', '6,3')
            .attr('opacity', 0.7);
          // Label
          svg.append('text')
            .attr('x', rx + 4).attr('y', 14)
            .attr('fill', '#d97706')
            .attr('font-size', '10px')
            .attr('font-weight', '600')
            .text('Article renamed');
          svg.append('text')
            .attr('x', rx + 4).attr('y', 26)
            .attr('fill', '#d97706')
            .attr('font-size', '9px')
            .attr('opacity', 0.7)
            .text('Pageviews shifted');
        }
      }

      // Data lines + crosshair tooltip
      const chartContainer = document.getElementById('chart')!;
      chartContainer.style.position = 'relative';

      const tooltip = d3.select('#chart')
        .append('div')
        .style('position', 'absolute')
        .style('background', 'white')
        .style('border', '1px solid #d1d5db')
        .style('border-radius', '8px')
        .style('padding', '10px 14px')
        .style('font-size', '13px')
        .style('pointer-events', 'none')
        .style('opacity', '0')
        .style('box-shadow', '0 4px 16px rgba(0,0,0,0.12)')
        .style('z-index', '10')
        .style('white-space', 'nowrap')
        .style('line-height', '1.6');

      const crosshairLine = svg.append('line')
        .attr('y1', 0).attr('y2', height)
        .attr('stroke', '#d1d5db')
        .attr('stroke-width', 1)
        .attr('stroke-dasharray', '4,3')
        .style('opacity', 0);

      // Build all series data for crosshair lookup
      const allSeriesData: Record<string, any[]> = {};
      const activeLegend: {label: string; color: string; value: number}[] = [];

      for (const src of activeSources) {
        const series = pairData[src];
        if (!series) continue;
        allSeriesData[src] = series;

        // A yearly point stands for its whole year, but the drawn line stops at the
        // point's own date — so ngrams (last point 2022-01) and openalex (2025-01)
        // ended a full year short of the coverage the hatching asserts, leaving a
        // blank strip that belonged to neither. Hold the final value across the
        // period it represents so the area matches the coverage. Monthly series
        // already close the gap, so only coarse cadences are extended, and the
        // synthetic point is NOT added to allSeriesData, so tooltips never report it.
        const plotSeries = (() => {
          if (!series.length || series.length < 2) return series;
          const ds = series.map((d: any) => parseDate(d.date)).filter(Boolean) as Date[];
          if (ds.length < 2) return series;
          const dl: number[] = [];
          for (let i = 1; i < ds.length; i++) dl.push(ds[i].getTime() - ds[i - 1].getTime());
          dl.sort((a, b) => a - b);
          const cad = dl[Math.floor(dl.length / 2)];
          if (cad <= 45 * 864e5) return series;            // monthly or finer
          const lastD = ds[ds.length - 1];
          const endT = Math.min(lastD.getTime() + cad, xEnd.getTime());
          if (endT - lastD.getTime() < 20 * 864e5) return series;
          const e = new Date(endT);
          const key = `${e.getFullYear()}-${String(e.getMonth() + 1).padStart(2, '0')}`;
          return [...series, { ...series[series.length - 1], date: key }];
        })();

        if (chartMode === 'volume') {
          // ── VOLUME MODE: lines with filled areas ──
          if (lineMode !== 'russian') {
            const ukrArea = d3.area<any>()
              .x((d: any) => x(parseDate(d.date)!))
              .y0(height)
              .y1((d: any) => y(d.ukr || 0))
              .curve(d3.curveMonotoneX);
            svg.append('path').datum(plotSeries)
              .attr('fill', sourceColors[src]).attr('opacity', 0.15)
              .attr('d', ukrArea);
            svg.append('path').datum(plotSeries)
              .attr('fill', 'none').attr('stroke', sourceColors[src]).attr('stroke-width', 3)
              .attr('d', d3.line<any>().x(d => x(parseDate(d.date)!)).y(d => y(d.ukr || 0)).curve(d3.curveMonotoneX));
          }
          if (lineMode !== 'ukrainian') {
            const rusArea = d3.area<any>()
              .x((d: any) => x(parseDate(d.date)!))
              .y0(height)
              .y1((d: any) => y(d.rus || 0))
              .curve(d3.curveMonotoneX);
            svg.append('path').datum(plotSeries)
              .attr('fill', '#dc2626').attr('opacity', 0.08)
              .attr('d', rusArea);
            svg.append('path').datum(plotSeries)
              .attr('fill', 'none').attr('stroke', '#dc2626')
              .attr('stroke-width', lineMode === 'russian' ? 3 : 1.5)
              .attr('stroke-dasharray', lineMode === 'russian' ? 'none' : '6,4')
              .attr('opacity', lineMode === 'russian' ? 1 : 0.5)
              .attr('d', d3.line<any>().x(d => x(parseDate(d.date)!)).y(d => y(d.rus || 0)).curve(d3.curveMonotoneX));
          }
        } else {
          // ── ADOPTION MODE: line chart with filled areas ──
          if (lineMode !== 'russian') {
            const uaArea = d3.area<any>()
              .x((d: any) => x(parseDate(d.date)!))
              .y0(height)
              .y1((d: any) => y(d.adoption))
              .curve(d3.curveMonotoneX);
            svg.append('path').datum(plotSeries)
              .attr('fill', sourceColors[src]).attr('opacity', 0.12)
              .attr('d', uaArea);
            svg.append('path').datum(plotSeries)
              .attr('fill', 'none').attr('stroke', sourceColors[src]).attr('stroke-width', 3)
              .attr('d', d3.line<any>().x(d => x(parseDate(d.date)!)).y(d => y(d.adoption)).curve(d3.curveMonotoneX));
          }

          if (lineMode !== 'ukrainian') {
            const russianLine = d3.line<any>()
              .x((d: any) => x(parseDate(d.date)!))
              .y((d: any) => y(100 - d.adoption))
              .curve(d3.curveMonotoneX);

            svg.append('path')
              .datum(plotSeries)
              .attr('fill', 'none')
              .attr('stroke', '#dc2626')
              .attr('stroke-width', lineMode === 'russian' ? 3 : 1.5)
              .attr('stroke-dasharray', lineMode === 'russian' ? 'none' : '6,4')
              .attr('opacity', lineMode === 'russian' ? 1 : 0.5)
              .attr('d', russianLine);
          }
        }

        const last = series[series.length - 1];

        activeLegend.push({
          label: sourceLabels[src],
          color: sourceColors[src],
          value: last.adoption,
        });
      }

      // Crosshair overlay — interpolates between data points
      svg.append('rect')
        .attr('width', width).attr('height', height)
        .attr('fill', 'transparent')
        .on('mousemove', function(event: MouseEvent) {
          const [mx] = d3.pointer(event);
          const hoveredDate = x.invert(mx);

          // Inside a hatched span there is nothing to report. The snap below picks
          // the nearest point at any distance, so hovering a gap used to surface the
          // last real month's values under the cursor -- a reading that belongs to a
          // different part of the chart entirely. Only one source renders at a time,
          // so the active source's gaps are the gaps.
          const ht = hoveredDate.getTime();
          for (const [ga, gb] of gapSpans) {
            if (ht > ga.getTime() && ht < gb.getTime()) {
              tooltip.style('opacity', '0');
              crosshairLine.style('opacity', 0);
              return;
            }
          }

          // The series is monthly: every point is one month's measured total. The
          // tooltip used to interpolate between the two bracketing months, so a cursor
          // between May and June reported a blend of the two -- a value that exists in
          // no month and was never measured -- under a real month's label. Snap to the
          // nearest actual point instead, and label it with THAT point's date.
          let snapDate: Date | null = null;
          {
            let best = Infinity;
            for (const src of Object.keys(allSeriesData)) {
              for (const d of allSeriesData[src]) {
                const dt = parseDate(d.date);
                if (!dt) continue;
                const gap = Math.abs(dt.getTime() - hoveredDate.getTime());
                if (gap < best) { best = gap; snapDate = dt; }
              }
            }
          }
          if (!snapDate) { tooltip.style('opacity', '0'); crosshairLine.style('opacity', 0); return; }
          const dateStr = d3.timeFormat('%b %Y')(snapDate);
          const snapT = snapDate.getTime();

          crosshairLine.attr('x1', x(snapDate)).attr('x2', x(snapDate)).style('opacity', 1);

          let html = `<strong>${dateStr}</strong>`;
          for (const src of Object.keys(allSeriesData)) {
            const series = allSeriesData[src];
            if (series.length < 2) continue;

            // Exact match on the snapped month, or nothing. A source without a point
            // that month is absent from the tooltip rather than approximated.
            const pt = series.find((d: any) => {
              const dt = parseDate(d.date);
              return dt && Math.abs(dt.getTime() - snapT) < 86400000;
            });
            if (!pt) continue;

            if (chartMode === 'volume') {
              const ukr = pt.ukr || 0;
              const rus = pt.rus || 0;
              const total = ukr + rus;
              const adopt = total > 0 ? Math.round(ukr / total * 1000) / 10 : 0;
              html += `<br/><span style="color:${sourceColors[src]}">● ${sourceLabels[src]}</span>`;
              html += `<br/>&nbsp;&nbsp;<span style="color:${sourceColors[src]}">UA: <strong>${ukr.toLocaleString()}</strong></span>`;
              html += `<br/>&nbsp;&nbsp;<span style="color:#dc2626">RU: <strong>${rus.toLocaleString()}</strong></span>`;
              html += `<br/>&nbsp;&nbsp;<span style="color:#6b7280">Adoption: ${adopt}%</span>`;
            } else {
              html += `<br/><span style="color:${sourceColors[src]}">● ${sourceLabels[src]}: <strong>${pt.adoption}%</strong></span>`;
            }
          }

          // Hide tooltip if only the header (no source matched)
          if (html === `<strong>${dateStr}</strong>`) {
            tooltip.style('opacity', '0');
            crosshairLine.style('opacity', 0);
            return;
          }
          tooltip.style('opacity', '1').html(html);
          const cr = chartContainer.getBoundingClientRect();
          const left = event.clientX - cr.left;
          const top = event.clientY - cr.top;
          const tipNode = tooltip.node() as HTMLElement;
          const tipW = tipNode ? tipNode.offsetWidth : 180;
          const tipX = left > width / 2 ? left - tipW - 16 : left + 16;
          tooltip.style('left', tipX + 'px')
            .style('top', Math.max(0, top - 40) + 'px');
        })
        .on('mouseleave', function() {
          crosshairLine.style('opacity', 0);
          tooltip.style('opacity', '0');
        });

      // (percentage legend removed; the events legend appended above stays)
    }

    // Sidebar
    document.querySelectorAll('.sidebar-header').forEach(header => {
      header.addEventListener('click', () => {
        header.classList.toggle('open');
        header.nextElementSibling?.classList.toggle('open');
      });
    });

    function selectPair(pairSlug: string) {
      activePairSlug = pairSlug;

      showView('pair');
      // Close mobile menu on selection
      document.getElementById('sidebar-aside')?.classList.remove('mobile-open');
      document.getElementById('sidebar-overlay')?.classList.remove('open');
      document.querySelectorAll('.sidebar-item').forEach(i => {
        const slug = (i as HTMLElement).dataset.pairSlug || '';
        i.classList.toggle('active', slug === pairSlug);
        if (slug === pairSlug) {
          const section = i.closest('.sidebar-section');
          if (section) {
            section.querySelector('.sidebar-header')?.classList.add('open');
            section.querySelector('.sidebar-items')?.classList.add('open');
          }
        }
      });
      const pair = (pairs as any).pairs.find((p: any) => p.slug === pairSlug);
      if (pair) {
        document.getElementById('chart-new')!.textContent = pair.ukrainian;
        document.getElementById('chart-old')!.textContent = pair.russian;
        const reportLink = document.getElementById('topbar-report-link') as HTMLAnchorElement;
        if (reportLink) reportLink.href = `/report#pair-${pairId}`;
      }
      drawChart();
      drawAdoptionCalc();
      drawPairClContext();
      // setTimeout ensures browser has fully laid out pair-view before measuring widths.
      // Each draw is wrapped so a single failure doesn't cascade and leave later
      // panels (e.g. world map, holdouts) empty when an earlier panel throws.
      setTimeout(() => {
        const safeDraw = (name: string, fn: () => void) => {
          try { fn(); } catch (e) { console.error(`[${name}] failed:`, e); }
        };
        safeDraw('renderHoldouts', renderHoldouts);
        safeDraw('drawPairLLM', drawPairLLM);
        safeDraw('drawClusterScatter', drawClusterScatter);
      }, 50);
    }

    // ONE horizontal bar component, used by both the Adoption Calculation card and the
    // Source Comparison card. They render the same numbers -- last.adoption per source --
    // and previously did it twice in two different technologies (inline HTML vs a d3 SVG),
    // so they could drift apart visually while claiming to show the same thing.
    type BarRow = { src: string; pct: number; ukr: number; rus: number };

    function sourceBarRows(): BarRow[] {
      // ONE window for everything on a row. Previously the bar showed the latest
      // month, the headline the 12-month mean, and the counts lifetime totals —
      // Reddit read 22.6% beside counts implying 26.8%, Telegram "100%" beside
      // 175·17. Percent and counts now both come from the last 12 study months.
      const SINCE = '2025-01';
      const rows: BarRow[] = [];
      for (const src of ['trends','gdelt','wikipedia','reddit','youtube','ngrams','openalex','telegram']) {
        const series = (pairData as any)[src];
        if (!series || !series.length) continue;
        const win = series.filter((d: any) => d.date >= SINCE);
        if (!win.length) continue;
        let ukr = 0, rus = 0, wsum = 0, asum = 0;
        for (const d of win) {
          ukr += d.ukr || 0; rus += d.rus || 0;
          if (d.adoption !== null && d.adoption !== undefined) {
            const w = (d.ukr || 0) + (d.rus || 0) || 1;
            asum += d.adoption * w; wsum += w;
          }
        }
        const countable = !(src === 'trends' || src === 'ngrams');
        const pct = countable
          ? (ukr + rus > 0 ? +(ukr / (ukr + rus) * 100).toFixed(1) : null)
          : (wsum ? +(asum / wsum).toFixed(1) : null);
        if (pct === null || (countable && ukr + rus < 5)) continue;
        rows.push({ src, pct, ukr: countable ? Math.round(ukr) : 0, rus: countable ? Math.round(rus) : 0 });
      }
      return rows;
    }

    function renderSourceBars(el: HTMLElement | null, rows: BarRow[],
                              opts: { barH?: number; labelW?: number } = {}) {
      if (!el) return;
      if (!rows.length) { el.innerHTML = ''; return; }
      const { barH = 9, labelW = 66 } = opts;
      const fN = (n: number) => n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'K' : String(n);
      const out = rows.map(r => {
        return `<div style="display:flex; align-items:center; gap:0.4rem;">
          <span style="width:${labelW}px; font-size:0.81rem; color:var(--text-muted); text-align:right; flex-shrink:0;">${sourceLabels[r.src].split(' ')[0]}</span>
          <div style="flex:1; height:${barH}px; background:#f0f0f0; border-radius:${barH / 2}px; position:relative; overflow:hidden;">
            <div style="position:absolute; left:50%; top:0; bottom:0; width:1px; background:#d1d5db;"></div>
            <div style="height:100%; width:${Math.max(1, Math.min(100, r.pct))}%; background:${sourceColors[r.src]}; border-radius:${barH / 2}px; opacity:0.85;"></div>
          </div>
          <span style="width:42px; font-size:0.82rem; font-weight:600; color:${sourceColors[r.src]}; text-align:right; flex-shrink:0;">${r.pct}%</span>
          <span style="min-width:7.5rem; font-size:0.76rem; text-align:right; flex-shrink:0;">${
            (r.ukr || r.rus)
              ? `<span style="color:#0057B8;">${fN(r.ukr)}</span> <span style="color:#9ca3af;">·</span> <span style="color:#dc2626;">${fN(r.rus)}</span> <span style="color:#9ca3af;">${(((manifest as any).pair_source_stats || {})[activePairSlug]?.[r.src] || {}).unit || ''}</span>`
              : `<span style="color:#9ca3af;">${(((manifest as any).pair_source_stats || {})[activePairSlug]?.[r.src] || {}).unit || ''}</span>`
          }</span>
        </div>`;
      }).join('');
      el.innerHTML = `<div style="display:flex; flex-direction:column; gap:0.25rem;">${out}</div>`;
    }

    (function wireAdoptionPop() {
      const btn = document.getElementById('adoption-details-btn');
      const pop = document.getElementById('adoption-pop');
      if (!btn || !pop || (btn as any)._wired) return;
      (btn as any)._wired = true;
      btn.addEventListener('click', (e) => { e.stopPropagation(); pop.hidden = !pop.hidden; });
      document.getElementById('adoption-pop-close')?.addEventListener('click', () => { pop.hidden = true; });
      document.addEventListener('click', (e) => {
        if (!pop.hidden && !pop.contains(e.target as Node) && e.target !== btn) pop.hidden = true;
      });
    })();

    function drawAdoptionCalc() {
      const pair = (pairs as any).pairs.find((p: any) => p.slug === activePairSlug);
      const titleEl = document.getElementById('adoption-pct-title');
      const rowsNow = sourceBarRows();
      const mean = rowsNow.length ? (rowsNow.reduce((a, r) => a + r.pct, 0) / rowsNow.length) : null;
      if (titleEl) titleEl.textContent = mean === null ? '—' : `${mean.toFixed(1)}%`;
      renderSourceBars(document.getElementById('adoption-calc-body'), rowsNow, { barH: 9, labelW: 72 });
    }

    // ── Per-pair LLM scan: 71 frontier models × 3 prompt variants for THIS pair ──
    // Astro doesn't bundle JSON imports into client scripts (works only in
    // server-side JSX expressions). Read the data from the inline JSON script
    // tag instead.
    let _llmPerPairCache: any = null;
    function getLlmPerPair() {
      if (_llmPerPairCache !== null) return _llmPerPairCache;
      const el = document.getElementById('llm-per-pair-data');
      if (!el || !el.textContent) {
        _llmPerPairCache = {};
        return _llmPerPairCache;
      }
      try {
        _llmPerPairCache = JSON.parse(el.textContent);
      } catch (e) {
        console.error('[drawPairLLM] failed to parse llm-per-pair-data:', e);
        _llmPerPairCache = {};
      }
      return _llmPerPairCache;
    }

    function drawPairLLM() {
      const container = document.getElementById('pair-llm-container');
      const body = document.getElementById('pair-llm-body');
      const nameEl = document.getElementById('pair-llm-pair-name');
      if (!container || !body) {
        console.warn('[drawPairLLM] container or body missing', {container, body});
        return;
      }

      const llmPerPair = getLlmPerPair();
      const pid = activePairSlug;
      const pp = llmPerPair.pairs?.[pid];
      if (!pp || !pp.models) {
        body.innerHTML = `<div style="font-size:0.82rem; color:var(--text-muted); padding:0.5rem 0;">No LLM data for pair ${pid}.</div>`;
        return;
      }
      container.style.display = '';

      const families = llmPerPair.families || {};
      const modelLabel = (key: string) => key
        .replace('claude-', '')
        .replace('gemini-', '')
        .replace('gemma-', 'g')
        .replace('gpt-', '')
        .replace('grok-', '');

      // Header label
      if (nameEl) nameEl.textContent = `${pp.russian} / ${pp.ukrainian}`;

      // Build the table HTML manually for max control
      const sum = pp.summary;
      const fmt = (v: any) => v == null ? '—' : (typeof v === 'number' ? v.toFixed(0) + '%' : String(v));

      // Sort models by tas descending
      const models = [...pp.models].sort((a, b) => (b.tas ?? -1) - (a.tas ?? -1));

      // Group by family for the per-family rollup row
      const familyOrder = Object.keys(sum.by_family || {}).sort((a, b) => sum.by_family[b].n - sum.by_family[a].n);

      let html = '';

      // Top: 3 big numbers (open / forced / TAS)
      html += `
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.5rem; margin-bottom:0.75rem;">
          <div style="padding:0.6rem 0.75rem; background:rgba(213,43,30,0.05); border-left:3px solid #D52B1E; border-radius:3px;">
            <div style="font-size:0.78rem; text-transform:uppercase; color:var(--text-muted); font-weight:700;">Free recall</div>
            <div style="font-size:1.4rem; font-weight:700; color:var(--text);">${fmt(sum.open_pct)}</div>
            <div style="font-size:0.78rem; color:var(--text-muted);">of models pick "${pp.ukrainian}" when generating</div>
          </div>
          <div style="padding:0.6rem 0.75rem; background:rgba(0,87,184,0.05); border-left:3px solid #0057B8; border-radius:3px;">
            <div style="font-size:0.78rem; text-transform:uppercase; color:var(--text-muted); font-weight:700;">Forced choice (avg)</div>
            <div style="font-size:1.4rem; font-weight:700; color:var(--text);">${fmt(((sum.forced_ru_pct || 0) + (sum.forced_ua_pct || 0)) / 2)}</div>
            <div style="font-size:0.78rem; color:var(--text-muted);">when shown both spellings</div>
          </div>
          <div style="padding:0.6rem 0.75rem; background:rgba(0,87,184,0.03); border-left:3px solid var(--text-muted); border-radius:3px;">
            <div style="font-size:0.78rem; text-transform:uppercase; color:var(--text-muted); font-weight:700;">TAS (weighted)</div>
            <div style="font-size:1.4rem; font-weight:700; color:var(--text);">${fmt(sum.tas_mean)}</div>
            <div style="font-size:0.78rem; color:var(--text-muted);">across ${sum.n_models} frontier models</div>
          </div>
        </div>
      `;

      // Per-family rollup mini-bars
      // Show concrete counts (e.g. "3/3" or "17/17") in addition to %
      // because "100%" with N=3 looks identical to "100%" with N=71 and
      // misleads users into thinking small samples are universal truths.
      html += `<div style="font-size:0.82rem; font-weight:700; color:var(--text); margin:0.75rem 0 0.4rem;">By family</div>`;
      const safePct = (v: any) => (typeof v === 'number' ? v : 0);
      // Per-family raw counts: walk pp.models and tally
      const famCounts: Record<string, {open_ua: number, open_n: number, forced_ua: number, forced_n: number}> = {};
      for (const m of pp.models) {
        const k = m.family;
        if (!famCounts[k]) famCounts[k] = {open_ua: 0, open_n: 0, forced_ua: 0, forced_n: 0};
        if (m.x_open === 1) famCounts[k].open_ua++;
        if (m.x_open != null) famCounts[k].open_n++;
        for (const v of [m.x_forced_ru_first, m.x_forced_ua_first]) {
          if (v === 1) famCounts[k].forced_ua++;
          if (v != null) famCounts[k].forced_n++;
        }
      }
      for (const fam of familyOrder) {
        const f = sum.by_family[fam];
        const counts = famCounts[fam] || {open_ua: 0, open_n: 0, forced_ua: 0, forced_n: 0};
        const color = families[fam]?.color || '#666';
        const opPct = safePct(f.open_pct);
        const fcPct = safePct(f.forced_pct);
        html += `
          <div style="display:grid; grid-template-columns:150px 1fr 1fr; gap:0.5rem; align-items:center; margin-bottom:0.3rem; font-size:0.8rem;">
            <div style="color:var(--text); display:flex; align-items:center; gap:0.25rem; min-width:0;">
              <span style="display:inline-block; width:8px; height:8px; border-radius:2px; background:${color}; flex-shrink:0;"></span>
              <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${fam}</span>
              <span style="color:var(--text-muted); font-family:monospace; flex-shrink:0;">×${f.n}</span>
            </div>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <div style="flex:1; height:12px; background:#f0f0f0; border-radius:2px; overflow:hidden;">
                <div style="width:${opPct}%; height:100%; background:#D52B1E; opacity:0.85;"></div>
              </div>
              <span style="font-family:monospace; color:var(--text-muted); font-size:0.78rem; width:36px; text-align:right;">${counts.open_ua}/${counts.open_n}</span>
            </div>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <div style="flex:1; height:12px; background:#f0f0f0; border-radius:2px; overflow:hidden;">
                <div style="width:${fcPct}%; height:100%; background:#0057B8; opacity:0.85;"></div>
              </div>
              <span style="font-family:monospace; color:var(--text-muted); font-size:0.78rem; width:42px; text-align:right;">${counts.forced_ua}/${counts.forced_n}</span>
            </div>
          </div>
        `;
      }
      html += `
        <div style="display:grid; grid-template-columns:150px 1fr 1fr; gap:0.5rem; font-size:0.76rem; color:var(--text-muted); margin-top:0.5rem; padding-top:0.4rem; border-top:1px solid rgba(0,0,0,0.06);">
          <div></div>
          <div style="display:flex; align-items:center; gap:0.3rem;"><span style="width:8px; height:8px; background:#D52B1E; display:inline-block; border-radius:1px;"></span>free recall — UA picks / total decisive</div>
          <div style="display:flex; align-items:center; gap:0.3rem;"><span style="width:8px; height:8px; background:#0057B8; display:inline-block; border-radius:1px;"></span>forced choice — UA picks / 2 trials per model</div>
        </div>
      `;

      // Per-model scatter plot — one circle per model, grouped by family on X,
      // TAS on Y. Replaces the giant table; hover shows model + TAS.
      html += `<div style="font-size:0.82rem; font-weight:700; color:var(--text); margin:1rem 0 0.25rem;">All ${models.length} models · TAS by family</div>`;
      html += `<div style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.4rem;">Each dot is one model. Y axis is TAS (0–100%). Hover for the model name and its three trial outcomes.</div>`;
      html += `<div id="pair-llm-scatter" style="width:100%; height:240px;"></div>`;

      body.innerHTML = html;

      // ── render the scatter into #pair-llm-scatter ──
      const scatterEl = document.getElementById('pair-llm-scatter');
      if (!scatterEl) return;
      const sw = scatterEl.clientWidth || 600;
      const sh = 240;
      const sm = {top: 12, right: 12, bottom: 44, left: 32};
      const innerW = sw - sm.left - sm.right;
      const innerH = sh - sm.top - sm.bottom;

      const svgScatter = d3.select('#pair-llm-scatter')
        .append('svg')
        .attr('width', sw)
        .attr('height', sh);
      const gScatter = svgScatter.append('g').attr('transform', `translate(${sm.left},${sm.top})`);

      const xScatter = d3.scaleBand<string>()
        .domain(familyOrder)
        .range([0, innerW])
        .padding(0.15);
      const yScatter = d3.scaleLinear().domain([0, 100]).range([innerH, 0]);

      // Y gridlines + axis labels
      [0, 25, 50, 75, 100].forEach((v) => {
        gScatter.append('line')
          .attr('x1', 0).attr('x2', innerW)
          .attr('y1', yScatter(v)).attr('y2', yScatter(v))
          .attr('stroke', '#eef0f3').attr('stroke-width', 1);
        gScatter.append('text')
          .attr('x', -6).attr('y', yScatter(v))
          .attr('text-anchor', 'end').attr('dominant-baseline', 'middle')
          .style('font-size', '9px').style('fill', '#9ca3af')
          .text(v + '%');
      });

      // X axis: family labels (rotated)
      familyOrder.forEach((fam: string) => {
        const cx = (xScatter(fam) || 0) + xScatter.bandwidth() / 2;
        gScatter.append('text')
          .attr('x', cx).attr('y', innerH + 14)
          .attr('text-anchor', 'end')
          .attr('transform', `rotate(-30, ${cx}, ${innerH + 14})`)
          .style('font-size', '9px').style('fill', 'var(--text-muted)')
          .text(fam);
      });

      // Tooltip
      const tip = d3.select('#pair-llm-scatter').append('div')
        .attr('id', 'pair-llm-scatter-tip')
        .style('position', 'absolute')
        .style('pointer-events', 'none')
        .style('background', 'rgba(17,24,39,0.95)')
        .style('color', '#fff')
        .style('padding', '5px 8px')
        .style('border-radius', '3px')
        .style('font-size', '10px')
        .style('font-family', 'monospace')
        .style('opacity', 0)
        .style('white-space', 'nowrap')
        .style('z-index', '10');
      scatterEl.style.position = 'relative';

      const trialChar = (v: any) => v === 1 ? 'UA' : (v === 0 ? 'RU' : '–');

      // Group dots per family and lay them out with simple jitter
      const byFam: Record<string, any[]> = {};
      for (const mdl of models) {
        if (mdl.tas == null) continue;
        if (!byFam[mdl.family]) byFam[mdl.family] = [];
        byFam[mdl.family].push(mdl);
      }
      const r = 4;
      familyOrder.forEach((fam: string) => {
        const list = byFam[fam] || [];
        const bandX = (xScatter(fam) || 0);
        const bw = xScatter.bandwidth();
        const color = families[fam]?.color || '#666';
        // simple beeswarm-ish: sort by tas, alternate left/right of center
        list.sort((a, b) => (b.tas ?? 0) - (a.tas ?? 0));
        list.forEach((mdl: any, i: number) => {
          // Deterministic jitter within band
          const t = list.length === 1 ? 0.5 : (i / (list.length - 1));
          // alternate around center for visual spread
          const offset = ((i % 2 === 0 ? 1 : -1) * (Math.floor(i / 2) + 1) * 5) % (bw / 2);
          const cx = bandX + bw / 2 + offset;
          const cy = yScatter((mdl.tas ?? 0) * 100);
          gScatter.append('circle')
            .attr('cx', cx).attr('cy', cy).attr('r', r)
            .attr('fill', color).attr('fill-opacity', 0.75)
            .attr('stroke', '#fff').attr('stroke-width', 1)
            .style('cursor', 'pointer')
            .on('mouseover', function(this: any, ev: any) {
              d3.select(this).attr('r', r + 2).attr('fill-opacity', 1);
              const pct = (mdl.tas * 100).toFixed(0);
              tip.html(
                `<b>${mdl.key}</b><br>` +
                `TAS ${pct}% · recall ${trialChar(mdl.x_open)} · RU-1st ${trialChar(mdl.x_forced_ru_first)} · UA-1st ${trialChar(mdl.x_forced_ua_first)}`
              ).style('opacity', 1);
            })
            .on('mousemove', function(ev: any) {
              const rect = (scatterEl as any).getBoundingClientRect();
              tip.style('left', (ev.clientX - rect.left + 10) + 'px')
                 .style('top', (ev.clientY - rect.top + 10) + 'px');
            })
            .on('mouseout', function(this: any) {
              d3.select(this).attr('r', r).attr('fill-opacity', 0.75);
              tip.style('opacity', 0);
            });
        });
      });
    }

    let newsFilter = 'all';

    // ONE place decides which holdout panel belongs to the active source.
    // Every panel is hidden first, then exactly one renderer runs. Previously each
    // renderer managed its own visibility across several call sites, so any path
    // that called one but not the other left a stale panel on screen -- which is how
    // selecting News could leave the YouTube table visible.
    const HOLDOUT_PANEL_IDS = ['news-holdouts-container', 'holdout-container'];
    const HOLDOUT_RENDERER: Record<string, () => void> = {
      gdelt:     drawNewsHoldouts,   // its own panel: article text, not just links
      reddit:    drawHoldoutTable,
      youtube:   drawHoldoutTable,
      wikipedia: drawHoldoutTable,
      openalex:  drawHoldoutTable,
      telegram:  drawHoldoutTable,
      // trends and ngrams have no holdout data: nothing renders.
    };


    function renderHoldouts() {
      HOLDOUT_PANEL_IDS.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
      const render = HOLDOUT_RENDERER[activeSource];
      if (render) { try { render(); } catch (e) { console.error('[renderHoldouts]', activeSource, e); } }
    }

    function drawNewsHoldouts() {
      const container = document.getElementById('news-holdouts-container');
      const list = document.getElementById('news-holdouts-list');
      if (!container || !list) return;
      list.innerHTML = '';

      const pairHoldouts = (holdoutsByPair as any)[activePairSlug];
      const articles: any[] = pairHoldouts?.news_articles || [];

      if (articles.length === 0) {
        container.style.display = 'none';
        return;
      }
      container.style.display = 'block';

      // Sort newest first
      const sorted = [...articles].sort((a: any, b: any) => (b.month || '').localeCompare(a.month || ''));

      // Every row is a Russian-form holdout — the export no longer emits any other
      // variant here. So there is nothing to filter between, and a per-row RU/UA
      // label would restate what the whole table already means.
      const DISPLAY_LIMIT = 100;
      const now = new Date();
      const twoYearsAgo = `${now.getFullYear() - 2}-${String(now.getMonth()+1).padStart(2,'0')}`;

      const displayed = sorted.slice(0, DISPLAY_LIMIT);
      for (const a of displayed) {
        const color = '#dc2626';
        const isRecent = (a.month || '') >= twoYearsAgo;   // tints the row; every row is a Russian holdout
        const item = document.createElement('div');
        item.style.cssText = `padding:0.5rem 0.75rem; border-bottom:1px solid var(--border, #e5e7eb); font-size:0.8rem; ${isRecent ? 'background:#fef2f2;' : ''}`;
        item.innerHTML = `
          <div style="display:flex; align-items:center; gap:0.4rem; margin-bottom:0.25rem;">
            <a href="${a.url}" target="_blank" rel="noopener" style="color:var(--text); text-decoration:none; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${a.domain}</a>
            <span style="color:var(--text-muted); font-size:0.82rem; margin-left:auto; flex-shrink:0;">${a.month || ''}</span>
          </div>
          <div style="color:var(--text-muted); font-size:0.86rem; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">${a.text_preview || ''}</div>
        `;
        list.appendChild(item);
      }

      if (filtered.length > DISPLAY_LIMIT) {
        const more = document.createElement('div');
        more.style.cssText = 'padding:0.75rem; text-align:center; color:var(--text-muted); font-size:0.8rem;';
        const totalArticles = (pairHoldouts as any)?._total_articles || filtered.length;
        more.textContent = `Showing ${DISPLAY_LIMIT} of ${totalArticles} articles`;
        list.appendChild(more);
      }

      // Summary
      const totalArticles = (pairHoldouts as any)?._total_articles || articles.length;
      const ua = articles.filter((a: any) => a.variant === 'ukrainian').length;
      const ru = articles.filter((a: any) => a.variant === 'russian').length;
      const recentRu = articles.filter((a: any) => a.variant === 'russian' && (a.month || '') >= twoYearsAgo).length;
      const subtitle = document.getElementById('news-holdouts-subtitle');
      if (subtitle) {
        subtitle.textContent = `${totalArticles} articles from ${new Set(articles.map((a: any) => a.domain)).size} outlets — ${ua} Ukrainian, ${ru} Russian form${recentRu > 0 ? ` · ${recentRu} major outlets still use Russian form in recent years` : ''}`;
      }

      // Wire up filter buttons
      document.querySelectorAll('[data-nfilter]').forEach(btn => {
        btn.addEventListener('click', () => {
          newsFilter = (btn as HTMLElement).dataset.nfilter!;
          document.querySelectorAll('[data-nfilter]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderHoldouts();
        });
      });
    }



    function drawPie(container: HTMLElement, slices: {label: string; value: number; color: string}[]) {
      const total = slices.reduce((s, d) => s + d.value, 0);
      if (total === 0) return;

      const size = 130;
      const r = size / 2 - 5;
      const cx = size / 2;
      const cy = size / 2;

      let svg = `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">`;
      let startAngle = -Math.PI / 2;

      for (const slice of slices) {
        const pct = slice.value / total;
        const angle = pct * 2 * Math.PI;
        const endAngle = startAngle + angle;
        const large = angle > Math.PI ? 1 : 0;

        const x1 = cx + r * Math.cos(startAngle);
        const y1 = cy + r * Math.sin(startAngle);
        const x2 = cx + r * Math.cos(endAngle);
        const y2 = cy + r * Math.sin(endAngle);

        if (pct > 0.001) {
          svg += `<path d="M${cx},${cy} L${x1},${y1} A${r},${r} 0 ${large},1 ${x2},${y2} Z" fill="${slice.color}" opacity="0.85"/>`;
        }
        startAngle = endAngle;
      }
      svg += '</svg>';

      // Legend below
      let legend = '<div style="display:flex; flex-direction:column; gap:0.2rem; margin-top:0.3rem;">';
      for (const slice of slices) {
        const pct = total > 0 ? (slice.value / total * 100).toFixed(1) : '0';
        const fmtVal = slice.value >= 1e6 ? (slice.value/1e6).toFixed(1)+'M' : slice.value >= 1e3 ? (slice.value/1e3).toFixed(1)+'K' : String(slice.value);
        legend += `<div style="display:flex; align-items:center; gap:0.3rem; font-size:0.81rem;">`;
        legend += `<span style="width:8px; height:8px; border-radius:2px; background:${slice.color}; flex-shrink:0;"></span>`;
        legend += `<span style="color:var(--text);">${slice.label}</span>`;
        legend += `<span style="color:var(--text-muted); margin-left:auto;">${pct}% (${fmtVal})</span>`;
        legend += '</div>';
      }
      legend += '</div>';

      container.innerHTML = svg + legend;
    }

    // drawPairStats removed: the header adoption summary + details popover
    // replaced both blocks that showed these numbers.


    document.querySelectorAll('.sidebar-item').forEach(item => {
      item.addEventListener('click', () => {
        selectPair((item as HTMLElement).dataset.pairSlug || '');
      });
    });

    // Mobile hamburger menu
    const hamburger = document.getElementById('hamburger-btn');
    const sidebarEl = document.getElementById('sidebar-aside');
    const overlay = document.getElementById('sidebar-overlay');
    function closeMobileMenu() {
      sidebarEl?.classList.remove('mobile-open');
      overlay?.classList.remove('open');
    }
    hamburger?.addEventListener('click', () => {
      const isOpen = sidebarEl?.classList.contains('mobile-open');
      if (isOpen) {
        closeMobileMenu();
      } else {
        sidebarEl?.classList.add('mobile-open');
        overlay?.classList.add('open');
      }
    });
    overlay?.addEventListener('click', closeMobileMenu);
    // Close menu when a pair is selected on mobile
    document.querySelectorAll('.sidebar-item').forEach(item => {
      item.addEventListener('click', closeMobileMenu);
    });

    // Initialize from URL param
    if (activePairSlug !== 1) {
      selectPair(activePairSlug);
    }

    // Source toggles — radio behavior (one at a time)
    document.querySelectorAll('.source-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const src = (btn as HTMLElement).dataset.source!;
        // Deactivate all, activate clicked
        document.querySelectorAll('.source-toggle').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeSource = src;
        activeSources = new Set([src]);



        try { drawChart(); } catch (e) { console.error('[drawChart]', e); }

        // Source-specific holdouts
        renderHoldouts();

        // Save source in URL for shareable links
        const url = new URL(window.location.href);
        url.searchParams.set('source', src);
        window.history.replaceState({}, '', url.toString());
      });
    });

    // Chart mode radio (Adoption % / Volume)
    document.querySelectorAll('.chart-mode').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chart-mode').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        chartMode = (btn as HTMLElement).dataset.chart as any;
        drawChart();
      });
    });

    // Line mode radio (All / UA / RU)
    document.querySelectorAll('.line-mode').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.line-mode').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        lineMode = (btn as HTMLElement).dataset.mode as any;
        drawChart();
      });
    });


    // ── Heatmap / pair overview ──────────────────────────
    function drawHeatmap() {
      const container = document.getElementById('heatmap-chart')!;
      container.innerHTML = '';

      const sorted = [...pairs.pairs].sort((a: any, b: any) => b.adoption - a.adoption);


      const rowHeight = 28;
      const totalHeight = sorted.length * rowHeight;
      container.style.height = totalHeight + 'px';

      const rect = container.getBoundingClientRect();
      const margin = { top: 0, right: 55, bottom: 0, left: 180 };
      const barWidth = rect.width - margin.left - margin.right;

      const svg = d3.select('#heatmap-chart')
        .append('svg')
        .attr('viewBox', `0 0 ${rect.width} ${totalHeight}`)
        .append('g')
        .attr('transform', `translate(${margin.left},0)`);

      const x = d3.scaleLinear().domain([0, 100]).range([0, barWidth]);

      const colorScale = (pct: number) => {
        if (pct >= 80) return '#059669';
        if (pct >= 50) return '#d97706';
        if (pct >= 20) return '#ea580c';
        return '#dc2626';
      };

      sorted.forEach((pair: any, i: number) => {
        const yPos = i * rowHeight;

        // Category dot
        svg.append('circle')
          .attr('cx', -170).attr('cy', yPos + rowHeight / 2)
          .attr('r', 4)
          .attr('fill', colorScale(pair.adoption));

        // Label: Ukrainian name
        svg.append('text')
          .attr('x', -160).attr('y', yPos + rowHeight / 2 + 4)
          .attr('fill', '#374151')
          .attr('font-size', '11px')
          .attr('font-weight', '500')
          .text(pair.ukrainian);

        // Old name (strikethrough)
        svg.append('text')
          .attr('x', -160).attr('y', yPos + rowHeight / 2 + 4)
          .attr('fill', 'transparent')
          .attr('font-size', '0px')
          .text('');

        // Background bar
        svg.append('rect')
          .attr('x', 0).attr('width', barWidth)
          .attr('y', yPos + 4)
          .attr('height', rowHeight - 8)
          .attr('fill', '#f3f4f6')
          .attr('rx', 2);

        // Value bar
        svg.append('rect')
          .attr('x', 0)
          .attr('width', x(pair.adoption))
          .attr('y', yPos + 4)
          .attr('height', rowHeight - 8)
          .attr('fill', colorScale(pair.adoption))
          .attr('opacity', 0.75)
          .attr('rx', 2);

        // Percentage
        svg.append('text')
          .attr('x', barWidth + 8)
          .attr('y', yPos + rowHeight / 2 + 4)
          .attr('fill', colorScale(pair.adoption))
          .attr('font-size', '11px')
          .attr('font-weight', '700')
          .attr('font-family', 'var(--font-mono)')
          .text(pair.adoption + '%');

      });
    }

    // ── World map ─────────────────────────────────────────


    // ── Holdout table ─────────────────────────────────────
    let holdoutFilter = 'all';

    function drawHoldoutTable() {
      // Renders whichever source the dispatcher routed here. Never decides WHETHER
      // it should run -- only whether there is anything to show.
      const container = document.getElementById('holdout-table');
      const panel = document.getElementById('holdout-container');
      if (!container) return;
      const hide = () => { if (panel) panel.style.display = 'none'; };
      const pairHoldouts = (holdoutsByPair as any)[activePairSlug] || {};
      const pair = (pairs as any).pairs.find((p: any) => p.slug === activePairSlug);

      const nameEl = document.getElementById('holdout-pair-name');
      if (nameEl && pair) nameEl.textContent = pair.russian;

      // Source-to-holdout key mapping
      const sourceToKey: Record<string, string> = {
        gdelt: 'news', trends: 'trends', wikipedia: 'wikipedia',
        reddit: 'reddit', youtube: 'youtube',
        telegram: 'telegram',
        openalex: 'openalex', ngrams: 'ngrams',
      };
      const holdoutKey = sourceToKey[activeSource];
      if (!holdoutKey) { hide(); return; }
      const items = pairHoldouts[holdoutKey] || [];

      // Update subtitle and filter visibility per source
      const subtitleEl = document.getElementById('holdout-subtitle');
      const subtitles: Record<string, string> = {
        news: 'News domains still using old spelling — 2025',
        wikipedia: 'Wikipedia pages with old spelling — 2025',
        reddit: 'Reddit posts still using old spelling — 2025',
        youtube: 'YouTube videos still using old spelling — 2025',
        telegram: 'Telegram channels still using old spelling — 2025',
        openalex: 'Most-cited papers still using the Russian spelling — 2020 onward',
        ngrams: 'Google Books corpus — compare spellings',
      };
      if (subtitleEl) subtitleEl.textContent = subtitles[holdoutKey] || 'Still using old spelling in 2025';

      // Show filter buttons only for news
      document.querySelectorAll('[data-holdout]').forEach(b => {
