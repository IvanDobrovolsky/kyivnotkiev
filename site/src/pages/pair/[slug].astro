---
import Base from '../../layouts/Base.astro';
import m from '../../data/manifest.json';
import ts from '../../data/timeseries.json';
import holdoutsData from '../../data/holdouts_by_pair.json';

// Svelte components
import PairStats from '../../lib/PairStats.svelte';
import SourceToggle from '../../lib/SourceToggle.svelte';
import TimeseriesChart from '../../lib/TimeseriesChart.svelte';
import WorldMap from '../../lib/WorldMap.svelte';
import MediaOrigin from '../../lib/MediaOrigin.svelte';
import HoldoutsTable from '../../lib/HoldoutsTable.svelte';
import LlmAudit from '../../lib/LlmAudit.svelte';
import ReligiousPanel from '../../lib/ReligiousPanel.svelte';

export function getStaticPaths() {
  const manifest = m as any;
  return manifest.pairs
    .filter((p: any) => !p.is_control)
    .map((p: any) => ({
      params: { slug: p.slug },
      props: { pair: p },
    }));
}

const { pair } = Astro.props;
const slug = pair.slug;
const title = `${pair.russian} → ${pair.ukrainian} — #KyivNotKiev`;

// Which sources have data
const pairTs = (ts as any)[slug] || {};
const availableSources = ['gdelt','trends','wikipedia','reddit','youtube','ngrams','openalex','telegram','religious']
  .filter(s => pairTs[s] && pairTs[s].length > 0);

const holdouts = (holdoutsData as any)[slug] || {};
---

<Base title={title}>
  <div class="pair-page">
    <a href="/" class="back">&larr; All pairs</a>

    <PairStats client:load pairSlug={slug} />

    <SourceToggle client:load pairSlug={slug} availableSources={availableSources} />

    <div class="chart-section">
      <TimeseriesChart client:load pairSlug={slug} />
    </div>

    <WorldMap client:visible pairSlug={slug} />

    <MediaOrigin client:visible pairSlug={slug} />

    <div class="section">
      <h3>Who still uses the old spelling</h3>
      <HoldoutsTable client:visible holdouts={holdouts} russianTerm={pair.russian} />
    </div>

    <LlmAudit client:visible pairSlug={slug} />

    <ReligiousPanel client:visible pairSlug={slug} />
  </div>
</Base>

<style>
  .pair-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: #6b7280;
    text-decoration: none;
  }
  .back:hover { color: #0057B8; }
  .chart-section { min-height: 400px; margin-bottom: 1.5rem; }
  .section { margin-bottom: 1.5rem; }
  h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
</style>
