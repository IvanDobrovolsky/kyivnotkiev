        html = `<p style="font-size:0.75rem; color:#6b7280; margin:0.5rem 0.6rem;">Reddit posts still using the old spelling in 2025:</p>
        <table style="width:100%; border-collapse:collapse;"><tbody>${rows}</tbody></table>`;

      } else if (holdoutKey === 'youtube') {
        const rows = items.map((y: any) =>
          `<tr style="border-bottom:1px solid #f3f4f6;">
            <td style="padding:0.5rem 0.6rem; font-size:0.85rem;"><a href="${y.url}" target="_blank" rel="noopener" style="color:#FF0000; text-decoration:none;">${y.name}</a></td>
          </tr>`).join('');
        html = `<table style="width:100%; border-collapse:collapse;"><tbody>${rows}</tbody></table>`;

      } else if (holdoutKey === 'telegram') {
