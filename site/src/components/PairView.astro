---
import { t } from '../i18n';
/**
 * Pair detail view — shown when a pair is selected from the sidebar.
 * All content is rendered dynamically by client-side JS via element IDs.
 * This component provides the HTML skeleton only.
 */
interface Props {
  llmTraj: any;
  llmPerPair: any;
  timeSpan: string;
}

const { llmTraj, llmPerPair, timeSpan, lang = 'en' } = Astro.props;
const nModels = llmTraj?.summary?.n_models || 72;
const nLabs = Object.keys(llmTraj?.families || {}).length || 8;
---

<div id="pair-view" style="display:none;">

<!-- Main time-series chart -->
<div class="chart-container">
  <div class="chart-header" style="flex-direction:column; align-items:stretch; gap:0.3rem;">
    <div style="display:flex; align-items:baseline; gap:0.5rem; flex-wrap:wrap;">
      <div class="chart-title" style="margin:0; white-space:nowrap;">
        <span class="old-name" id="chart-old">Kiev</span>
        <span class="arrow">→</span>
        <span class="new-name" id="chart-new">Kyiv</span>
      </div>
      <span id="chart-range" hidden></span>
      <!-- Adoption lives in the header now: one line, details on demand. Replaces
           both the "Adoption Calculation" card and the per-source stats list,
           which said the same numbers twice in two blocks. -->
      <span id="adoption-summary" style="margin-left:auto; position:relative; white-space:nowrap; font-size:0.86rem;">
        {t(lang, 'pair.estimated_adoption')} <strong id="adoption-pct-title" style="font-size:1rem;"></strong>
        <button id="adoption-details-btn" class="method-btn">{t(lang, 'pair.view_details')}</button>
        <div id="adoption-pop" class="info-pop" hidden style="right:0; left:auto; top:1.9rem; width:min(30rem,92vw); white-space:normal;">
          <button id="adoption-pop-close" aria-label="Close" style="position:absolute;top:6px;right:8px;border:none;background:none;font-size:14px;color:#9ca3af;cursor:pointer;">×</button>
          <p style="margin:0 0 0.5rem;" set:html={t(lang, "pair.avg_note_html")}></p>
          <div id="adoption-calc-body"></div>
        </div>
      </span>
    </div>
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.4rem;">
      <div class="chart-controls" style="margin:0;">
        <button class="source-toggle active" data-source="trends" style="--source-color: #4285F4"><span class="source-dot"></span>{t(lang, "sources.trends")}</button>
        <button class="source-toggle" data-source="gdelt" style="--source-color: #1e3a5f"><span class="source-dot"></span>{t(lang, "sources.gdelt")}</button>
        <button class="source-toggle" data-source="wikipedia" style="--source-color: #636466"><span class="source-dot"></span>{t(lang, "sources.wikipedia")}</button>
        <button class="source-toggle" data-source="reddit" style="--source-color: #FF4500"><span class="source-dot"></span>Reddit</button>
        <button class="source-toggle" data-source="youtube" style="--source-color: #FF0000"><span class="source-dot"></span>YouTube</button>
        <button class="source-toggle" data-source="ngrams" style="--source-color: #7c3aed"><span class="source-dot"></span>{t(lang, "sources.ngrams")}</button>
        <button class="source-toggle" data-source="openalex" style="--source-color: #06b6d4"><span class="source-dot"></span>{t(lang, "sources.openalex")}</button>
      </div>
      <div class="chart-controls" style="margin:0 0 0 auto;">
        <button class="chart-mode active" data-chart="volume" id="volume-btn">{t(lang, "pair.volume")}</button>
        <button class="chart-mode" data-chart="adoption">{t(lang, "pair.adoption_pct")}</button>
      </div>
    </div>
    <div style="display:flex; align-items:center; gap:0.9rem; flex-wrap:wrap; min-height:1.2rem;">
      <span id="chart-info" style="font-size:0.81rem; color:var(--text-dim);"></span>
      <span id="vol-legend" style="display:none; font-size:0.78rem; color:var(--text-muted); gap:0.7rem; align-items:center;"></span>
    </div>
  </div>
  <div id="chart" style="min-height:360px;"></div>
  <div class="chart-legend" id="chart-legend"></div>
</div>

<!-- CL: Context + Collocations -->
<div class="cl-two-cards" style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
  <div class="chart-container" id="pair-cl-context" style="margin-bottom:0;">
    <div class="chart-title" style="color: var(--text)">{t(lang, 'pair.discourse_ctx_title')}</div>
    <div class="chart-subtitle" style="margin-bottom:0.5rem;">{t(lang, 'pair.discourse_ctx_sub')}</div>
    <div id="pair-cl-body"></div>
  </div>
  <div class="chart-container" id="pair-cl-collocations" style="margin-bottom:0;">
    <div class="chart-title" style="color: var(--text)">{t(lang, 'pair.contrastive_title')}</div>
    <div class="chart-subtitle" style="margin-bottom:0.5rem; position:relative;">{t(lang, 'pair.contrastive_sub')}
      <button id="keyness-info-btn" class="method-btn">{t(lang, 'pair.view_methodology')}</button>
      <div id="keyness-info-pop" hidden class="info-pop">
        <button id="keyness-info-close" aria-label="Close" style="position:absolute;top:6px;right:8px;border:none;background:none;font-size:14px;color:#9ca3af;cursor:pointer;">×</button>
        <p><strong>How the words are chosen.</strong> Word counts from documents using each spelling are
        contrasted with a log-odds ratio under an informative Dirichlet prior (Monroe, Colaresi &amp;
        Quinn 2008), z-scored. The prior is the pooled corpus, so a word only scores when it exceeds
        the rate the whole corpus predicts &mdash; plain frequency or PMI over-reward rare words.</p>
        <p>Contrasts are computed <em>within each source</em> and a word is shown only when it leans the
        same way in two or more sources (|z| &ge; 2) &mdash; separating discourse from source register.
        Possessives fold into their stem; outlet names, URL debris and stopwords are excluded.</p>
        <p>When one spelling is too rare to contrast (under 25 documents per source), the dominant
        form is profiled against a cross-pair background sample instead, and a term must appear
        across at least five distinct outlets to ship.</p>
      </div>
    </div>
    <div id="pair-cl-coll-body"></div>
  </div>
</div>

<!-- CL: Discourse Clusters -->
<div class="chart-container" id="cluster-container" style="margin-bottom:0.75rem; display:none;">
  <div class="chart-title" style="color: var(--text)">{t(lang, 'pair.discourse_title')}</div>
  <div class="chart-subtitle" id="cluster-subtitle" style="margin-bottom:0.5rem; position:relative;">
    {t(lang, 'pair.cluster_sub')}
    <button id="cluster-info-btn" class="method-btn">{t(lang, 'pair.view_methodology')}</button>
    <div id="cluster-info-pop" hidden class="info-pop">
      <button id="cluster-info-close" aria-label="Close" style="position:absolute;top:6px;right:8px;border:none;background:none;font-size:14px;color:#9ca3af;cursor:pointer;">×</button>
      <p><strong>How the groups are made.</strong> Every text is turned into a vector with a
      sentence-embedding model (<code>all-MiniLM-L6-v2</code>), compressed to 50 dimensions with PCA.</p>
      <p>A <strong>mixture of Gaussians</strong> is fitted with the <strong>EM algorithm</strong>: each text
      x<sup>(i)</sup> is modelled as drawn from one of k Gaussians selected by a <strong>latent</strong>
      variable z<sup>(i)</sup>&nbsp;&sim;&nbsp;Multinomial(&phi;), with
      x<sup>(i)</sup>&thinsp;|&thinsp;z<sup>(i)</sup>&hairsp;=&hairsp;j &sim; &#119977;(&mu;<sub>j</sub>, &Sigma;<sub>j</sub>).
      The <strong>E-step</strong> computes the &ldquo;soft&rdquo; assignments by Bayes rule:</p>
      <p class="formula">w<sub>j</sub><sup>(i)</sup> := p(z<sup>(i)</sup>&hairsp;=&hairsp;j&thinsp;|&thinsp;x<sup>(i)</sup>; &phi;, &mu;, &Sigma;) =
        <span class="frac"><span>p(x<sup>(i)</sup>|z<sup>(i)</sup>&hairsp;=&hairsp;j;&thinsp;&mu;,&Sigma;)&thinsp;&phi;<sub>j</sub></span><span>&Sigma;<sub>l</sub> p(x<sup>(i)</sup>|z<sup>(i)</sup>&hairsp;=&hairsp;l;&thinsp;&mu;,&Sigma;)&thinsp;&phi;<sub>l</sub></span></span></p>
      <p>The <strong>M-step</strong> re-estimates &phi;<sub>j</sub>, &mu;<sub>j</sub>, &Sigma;<sub>j</sub> from those
      weights, and the two steps repeat until the log-likelihood &ell;(&phi;, &mu;, &Sigma;) converges —
      soft assignments w<sub>j</sub><sup>(i)</sup> in place of k-means&rsquo; hard c<sup>(i)</sup>.
      k is chosen by BIC; groups whose vocabulary overlaps &ge;50% are merged —
      unless their Ukrainian shares differ by over 20 points, so a spelling split is never merged away.
      A text whose top two posteriors are within 0.20 counts as <em>between</em> groups.
      The 2-D layout is a UMAP projection: positions are for reading, distances are approximate.</p>
      <div id="cluster-info-viz"></div>
      <p id="cluster-info-stats" style="color:#6b7280; margin:0.4rem 0 0;"></p>
    </div>
  </div>
  <div id="cluster-scatter" style="width:100%; height:400px; position:relative;"></div>
  <div id="cluster-legend" style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.5rem; font-size:0.82rem;"></div>
  <div id="cluster-clip-note" style="font-size:0.72rem; color:var(--text-dim); margin-top:0.25rem;"></div>

</div>



<!-- Per-pair AI / LLM scan -->
<div class="chart-container" id="pair-llm-container" style="margin-bottom:1rem;">
  <div class="chart-title" style="color: var(--text)">{t(lang, 'pair.ai_title')} <span id="pair-llm-pair-name">this pair</span></div>
  <div class="chart-subtitle" style="margin-bottom:0.5rem;" id="pair-llm-subtitle">
    {t(lang, "pair.ai_sub", {n: nModels, labs: nLabs})}
  </div>
  <div id="pair-llm-body"></div>
  <script type="application/json" id="llm-per-pair-data" set:html={JSON.stringify(llmPerPair)} />
</div>

<!-- World map -->
<div id="news-holdouts-container" class="chart-container" style="margin-bottom:1rem; padding:0.75rem;">
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
    <div>
      <div class="chart-title" style="color: var(--text)">{t(lang, 'pair.news_holdouts_title')}</div>
      <div class="chart-subtitle" id="news-holdouts-subtitle">{t(lang, "pair.news_holdouts_sub")}</div>
    </div>
  </div>
  <div id="news-holdouts-list" style="margin-top:0.5rem; max-height:500px; overflow-y:auto;"></div>
</div>

<!-- Generic per-source holdouts (YouTube, Wikipedia and any source without a dedicated panel).
     Hidden by default; drawHoldoutTable() reveals it only when the active source has rows. -->
<div id="holdout-container" class="chart-container" style="margin-bottom:1rem; padding:0.75rem; display:none;">
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
    <div>
      <div class="chart-title" style="color: var(--text)">{t(lang, 'pair.holdouts_title')} <span id="holdout-pair-name"></span></div>
      <div class="chart-subtitle" id="holdout-subtitle">{t(lang, "pair.holdouts_sub")}</div>
    </div>
  </div>
  <div id="holdout-table" style="margin-top:0.5rem; max-height:500px; overflow-y:auto;"></div>
</div>

</div><!-- end pair-view -->
