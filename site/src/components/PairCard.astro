---
/**
 * Single pair card for the home grid.
 */
interface Props {
  slug: string;
  russian: string;
  ukrainian: string;
  adoption: number;
  total: number | string;
  popularRank?: number;
  significance?: string;
  dataReady?: boolean;
  spark?: number[];
}

function adoptionColor(pct: number) {
  if (pct >= 70) return 'var(--green)';
  if (pct >= 40) return 'var(--orange)';
  return 'var(--red)';
}

const { slug, russian, ukrainian, adoption, total, popularRank = 999, significance = '', dataReady = false, spark = [] } = Astro.props;
const SW = 260, SH = 34;
function path(vals: number[], flip = false): string {
  if (vals.length < 2) return '';
  const step = SW / (vals.length - 1);
  return vals.map((v, i) => `${i ? 'L' : 'M'}${(i * step).toFixed(1)},${(SH - ((flip ? 100 - v : v) / 100) * SH).toFixed(1)}`).join('');
}
const pct = adoption || 0;
const color = adoptionColor(pct);
---

<a href={`/pair/${slug}`}
   class="pair-card"
   data-adoption={pct}
   data-total={total || 0}
   data-name={ukrainian}
   data-popular={popularRank}>
  <div class="pair-card-names">
    <span class="ready-dot" style={`background:${dataReady ? '#16a34a' : '#f59e0b'};`}
          title={dataReady ? 'Complete dataset — all sources fully collected' : 'Data collection in progress'}></span>
    <span class="pair-old">{russian}</span>
    <span class="pair-arrow">&rarr;</span>
    <span class="pair-new">{ukrainian}</span>
  </div>
  {significance && <div class="pair-card-why">{significance}</div>}
  {spark.length > 1 && (
    <svg class="pair-spark" viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" aria-hidden="true">
      <path d={path(spark, true)} fill="none" stroke="#dc2626" stroke-width="1.6" opacity="0.55" stroke-dasharray="4,3" />
      <path d={path(spark)} fill="none" stroke="#0057B8" stroke-width="2" />
    </svg>
  )}
  <div class="pair-card-row">
    <div class="pair-card-bar">
      <div class="pair-card-bar-fill" style={`width:${Math.min(pct, 100)}%; background:${color};`}></div>
    </div>
    <span class="pair-pct" style={`color:${color}`}>{pct}%</span>
  </div>
</a>

<style>
  .pair-card {
    text-decoration: none;
    display: block;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition: all 0.15s;
    cursor: pointer;
  }
  .pair-card:hover {
    border-color: var(--blue);
    box-shadow: 0 2px 8px rgba(0,87,184,0.08);
    text-decoration: none;
  }
  /* Names take a full row of their own. Sharing the row with the percentage meant
     a long pair wrapped to two lines while a short one stayed on one, so cards in
     the same grid row ended up different heights. */
  .ready-dot {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-right: 0.4rem;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .pair-card-names {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pair-card-why {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-top: 0.3rem;
  }
  .pair-spark {
    display: block;
    width: 100%;
    height: 34px;
    margin-top: 0.45rem;
  }
  .pair-card-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .pair-old {
    font-size: 0.95rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }
  .pair-arrow {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin: 0 0.2rem;
  }
  .pair-new {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .pair-pct {
    font-size: 0.95rem;
    font-weight: 700;
    flex: 0 0 auto;
    min-width: 2.6rem;
    text-align: right;
  }
  .pair-card-bar {
    flex: 1 1 auto;
    height: 4px;
    background: #f0f0f0;
    border-radius: 2px;
    overflow: hidden;
  }
  .pair-card-bar-fill {
    height: 100%;
    border-radius: 2px;
  }
</style>
