---
/**
 * Single pair card for the home grid.
 */
interface Props {
  slug: string;
  russian: string;
  ukrainian: string;
  adoption: number;
  total: number | string;
  popularRank?: number;
  significance?: string;
}

function adoptionColor(pct: number) {
  if (pct >= 70) return 'var(--green)';
  if (pct >= 40) return 'var(--orange)';
  return 'var(--red)';
}

const { slug, russian, ukrainian, adoption, total, popularRank = 999, significance = '' } = Astro.props;
const pct = adoption || 0;
const color = adoptionColor(pct);
---

<a href={`/pair/${slug}`}
   class="pair-card"
   data-adoption={pct}
   data-total={total || 0}
   data-name={ukrainian}
   data-popular={popularRank}>
  <div class="pair-card-names">
    <span class="pair-old">{russian}</span>
    <span class="pair-arrow">&rarr;</span>
    <span class="pair-new">{ukrainian}</span>
  </div>
  {significance && <div class="pair-card-why" title={significance}>{significance}</div>}
  <div class="pair-card-row">
    <div class="pair-card-bar">
      <div class="pair-card-bar-fill" style={`width:${Math.min(pct, 100)}%; background:${color};`}></div>
    </div>
    <span class="pair-pct" style={`color:${color}`}>{pct}%</span>
  </div>
</a>

<style>
  .pair-card {
    text-decoration: none;
    display: block;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition: all 0.15s;
    cursor: pointer;
  }
  .pair-card:hover {
    border-color: var(--blue);
    box-shadow: 0 2px 8px rgba(0,87,184,0.08);
    text-decoration: none;
  }
  /* Names take a full row of their own. Sharing the row with the percentage meant
     a long pair wrapped to two lines while a short one stayed on one, so cards in
     the same grid row ended up different heights. */
  .pair-card-names {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pair-card-why {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-top: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.2em;
  }
  .pair-card-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .pair-old {
    font-size: 0.95rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }
  .pair-arrow {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin: 0 0.2rem;
  }
  .pair-new {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .pair-pct {
    font-size: 0.95rem;
    font-weight: 700;
    flex: 0 0 auto;
    min-width: 2.6rem;
    text-align: right;
  }
  .pair-card-bar {
    flex: 1 1 auto;
    height: 4px;
    background: #f0f0f0;
    border-radius: 2px;
    overflow: hidden;
  }
  .pair-card-bar-fill {
    height: 100%;
    border-radius: 2px;
  }
</style>
