---
import '../styles/global.css';
import m from '../data/manifest.json';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

function fmtBig(n: string | number) {
  const v = typeof n === 'string' ? parseInt(n) : n;
  if (v >= 1_000_000_000) return (v / 1_000_000_000).toFixed(1) + 'B';
  if (v >= 1_000_000) return (v / 1_000_000).toFixed(1) + 'M';
  if (v >= 1_000) return (v / 1_000).toFixed(1) + 'K';
  return v.toString();
}

const {
  title = '#KyivNotKiev — Measuring Ukrainian Toponym Adoption',
  description = `In 2018 Ukraine asked the world to write Ukrainian names the Ukrainian way — cities, people, dishes, historical figures. This project tracks how far that took hold across ${m.time_span}, and asks the same of today's AI chatbots.`,
  activeNav = '',
} = Astro.props;

// "Pairs" is dropped: the wordmark already returns to the pair index, so it was a
// second link to the page the reader is usually on.
const navItems = [
  { href: '/about', id: 'about', label: 'About' },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title}</title>
  <meta name="description" content={description}>

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://kyivnotkiev.org/og.png">
  <meta property="og:url" content="https://kyivnotkiev.org">
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://kyivnotkiev.org/og.png">

  <link rel="icon" href="/logo.svg" type="image/svg+xml">
  <link rel="canonical" href="https://kyivnotkiev.org/">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="dev-banner">Work in progress — data collection is ongoing and figures on this site will change.</div>
  <nav class="site-nav">
    <div class="site-nav-inner">
      <a href="/" class="site-nav-logo">
        <img src="/logo.svg" alt="" style="height:26px; width:auto;">
        <span>#KyivNotKiev</span>
      </a>
      <div class="site-nav-links">
        {navItems.map(item => (
          <a href={item.href} class={activeNav === item.id ? 'active' : ''}>{item.label}</a>
        ))}
      </div>
    </div>
  </nav>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <span>Built by <a href="https://github.com/IvanDobrovolsky" target="_blank" rel="noopener">Ivan Dobrovolskyi</a></span>
      <span class="dot">·</span>
      <a href="https://github.com/IvanDobrovolsky/kyivnotkiev" target="_blank" rel="noopener">GitHub</a>
      <span class="dot">·</span>
      <a href="https://huggingface.co/KyivNotKiev" target="_blank" rel="noopener">Hugging Face</a>
      <span class="dot">·</span>
      <a href="/privacy.html">Privacy</a>
    </div>
  </footer>
</body>
</html>

<style>
  .site-nav {
    background: white;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-nav-inner {
    max-width: 1272px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
  }
  .site-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  .site-nav-logo span {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0057B8;
  }
  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .site-nav-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.85rem 1rem;
    transition: color 0.15s;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .site-nav-links a:hover {
    color: var(--text);
  }
  .site-nav-links a.active {
    color: #0057B8;
    border-bottom-color: #0057B8;
    font-weight: 600;
  }
  /* Body is a full-height column and main flexes to fill it, so the footer sits
     at the bottom of short pages and after the content on long ones — no
     hardcoded margins doing the positioning. */
  body { min-height: 100vh; display: flex; flex-direction: column; }
  .site-main {
    flex: 1 0 auto;
    width: 100%;
    max-width: 1272px;
    margin: 0 auto;
    padding: 0.75rem 1rem 2rem;
  }

  /* The four nav items plus the wordmark measure roughly 510px, so on a phone they
     exceeded the viewport — and body sets overflow-x: hidden, which CLIPS rather
     than scrolls, leaving the last item unreachable. Tighten the row and let it
     scroll on its own axis. */
  @media (max-width: 640px) {
    .site-nav-inner { padding: 0 0.6rem; gap: 0.5rem; }
    .site-nav-links {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .site-nav-links::-webkit-scrollbar { display: none; }
    .site-nav-links a { padding: 0.85rem 0.55rem; font-size: 0.8rem; white-space: nowrap; }
    .site-nav-logo span { font-size: 0.88rem; }
  }

  .site-footer { border-top: 1px solid var(--border, #e5e7eb); }
  .site-footer-inner {
    max-width: 1272px; margin: 0 auto; padding: 0.85rem 1rem;
    display: flex; gap: 0.6rem; flex-wrap: wrap;
    align-items: center; justify-content: center;
    font-size: 0.82rem; color: var(--text-muted, #6b7280);
  }
  .site-footer-inner a {
    font-size: 0.82rem; color: var(--text-muted, #6b7280); text-decoration: none;
  }
  .site-footer-inner .dot { opacity: 0.5; }
  .site-footer-inner a:hover { color: var(--text, #111); text-decoration: underline; }

  .dev-banner {
    background: #fef3c7;
    color: #92400e;
    text-align: center;
    font-size: 0.78rem;
    padding: 0.3rem 1rem;
    border-bottom: 1px solid #fde68a;
  }
</style>
