---
import '../styles/global.css';
import m from '../data/manifest.json';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

function fmtBig(n: string | number) {
  const v = typeof n === 'string' ? parseInt(n) : n;
  if (v >= 1_000_000_000) return (v / 1_000_000_000).toFixed(1) + 'B';
  if (v >= 1_000_000) return (v / 1_000_000).toFixed(1) + 'M';
  if (v >= 1_000) return (v / 1_000).toFixed(1) + 'K';
  return v.toString();
}

const {
  title = '#KyivNotKiev — Measuring Ukrainian Toponym Adoption',
  description = `In 2018, Ukraine launched a campaign to change how the world spells its place names. We built a data pipeline to measure whether it worked — ${fmtBig(m.toponym_matches)} matches across ${m.num_sources} sources.`,
  activeNav = '',
} = Astro.props;

// "Pairs" is dropped: the wordmark already returns to the pair index, so it was a
// second link to the page the reader is usually on.
import icons from '../data/source_icons.json';

const navItems = [
  { href: '/about', id: 'about', label: 'About' },
  { href: '/sources', id: 'sources', label: 'Sources' },
  { href: '/methodology', id: 'methodology', label: 'Methodology' },
  { href: '/llm', id: 'llm', label: 'AI Audit' },
];
const navExternal = [
  { href: 'https://github.com/IvanDobrovolsky/kyivnotkiev', icon: 'github', label: 'GitHub' },
  { href: 'https://huggingface.co/KyivNotKiev', icon: 'huggingface', label: 'Hugging Face' },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title}</title>
  <meta name="description" content={description}>

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://kyivnotkiev.org/og.png">
  <meta property="og:url" content="https://kyivnotkiev.org">
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://kyivnotkiev.org/og.png">

  <link rel="icon" href="/logo.svg" type="image/svg+xml">
  <link rel="canonical" href="https://kyivnotkiev.org/">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="site-nav">
    <div class="site-nav-inner">
      <a href="/" class="site-nav-logo">
        <img src="/logo.svg" alt="" style="height:26px; width:auto;">
        <span>#KyivNotKiev</span>
      </a>
      <div class="site-nav-links">
        {navItems.map(item => (
          <a href={item.href} class={activeNav === item.id ? 'active' : ''}>{item.label}</a>
        ))}
        <span class="nav-sep"></span>
        {navExternal.map(x => (
          <a href={x.href} class="nav-icon" target="_blank" rel="noopener"
             title={x.label} aria-label={x.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={(icons as any)[x.icon]?.path} /></svg>
          </a>
        ))}
        <a href="/privacy.html" class="nav-privacy" title="Privacy Policy">Privacy</a>
      </div>
    </div>
  </nav>

  <main class="site-main">
    <slot />
  </main>
</body>
</html>

<style>
  .site-nav {
    background: white;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
  }
  .site-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  .site-nav-logo span {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0057B8;
  }
  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .site-nav-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.85rem 1rem;
    transition: color 0.15s;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .site-nav-links a:hover {
    color: var(--text);
  }
  .site-nav-links a.active {
    color: #0057B8;
    border-bottom-color: #0057B8;
    font-weight: 600;
  }
  .site-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1rem 2rem;
  }

  /* The four nav items plus the wordmark measure roughly 510px, so on a phone they
     exceeded the viewport — and body sets overflow-x: hidden, which CLIPS rather
     than scrolls, leaving the last item unreachable. Tighten the row and let it
     scroll on its own axis. */
  @media (max-width: 640px) {
    .site-nav-inner { padding: 0 0.6rem; gap: 0.5rem; }
    .site-nav-links {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .site-nav-links::-webkit-scrollbar { display: none; }
    .site-nav-links a { padding: 0.85rem 0.55rem; font-size: 0.8rem; white-space: nowrap; }
    .site-nav-logo span { font-size: 0.88rem; }
  }

  .nav-sep {
    width: 1px; height: 16px; background: var(--border, #e5e7eb); margin: 0 0.35rem;
    flex: 0 0 auto;
  }
  .nav-icon { display: inline-flex; align-items: center; padding: 0.85rem 0.5rem; }
  .nav-icon svg { width: 15px; height: 15px; fill: var(--text-muted, #6b7280); }
  .nav-icon:hover svg { fill: var(--text, #111); }
  /* Kept in the nav rather than a footer: the YouTube API Services terms require a
     reachable privacy policy, and in the footer it appeared on the home page only. */
  .nav-privacy { font-size: 0.74rem !important; opacity: 0.75; }
</style>
