# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
.python-version
uv.lock

# Data (large files — stored in GCS/BigQuery)
data/raw/**/*.parquet
data/raw/**/*.csv
data/raw/**/*.zst
data/processed/**/*.parquet
data/processed/**/*.csv

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Terraform
infrastructure/.terraform/
infrastructure/.terraform.lock.hcl
infrastructure/terraform.tfstate*
*.tfvars

# Credentials & secrets
*.json
!data/toponym_pairs.json
.gcloud/
*credentials*.json
*service-account*.json
*key*.json
*.pem
*.p12
.env
.env.*
!.env.example

# Generated figures (reproduced from pipeline)
/figures/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

.claude
.astro/
data/raw/screenshots/
vastai_bundle.tar.gz
data/bq_export/
data/hf_export/

# CL raw data (large, reproducible from pipeline)
data/cl/raw/**/*.parquet
data/cl/raw/**/*.csv
data/cl/raw/**/*.session
data/cl/raw/**/*.session-journal
output/

# All data (source of truth is HuggingFace).
# "/data/*" not "/data/": git does not descend into an excluded DIRECTORY, so
# with "/data/" the negations below can never fire, however they are written.
/data/*
/output/
/dataset/
# Keep site data JSON (generated, needed for build)
!site/src/data/
!site/src/data/*.json

# Hand-written editorial content, NOT derived data. The pipeline reads these;
# nothing regenerates them. 375 collocation glosses, 128 cluster names and
# descriptions and the term blocklist were written by hand against measured
# evidence, and they lived only on one disk because /data/ is ignored wholesale.
# HuggingFace is the source of truth for the CORPUS, not for this.
!/data/audit/
/data/audit/*
!/data/audit/collocation_glosses.json
!/data/audit/cluster_names.json
!/data/audit/cluster_glosses.json
!/data/audit/term_blocklist.json
!/data/audit/*.md

private/
node_modules/
.astro/

!site/src/i18n/*.json
