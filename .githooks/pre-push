#!/bin/zsh
# Push gate: build the COMMITTED tree, not the working tree. A local build can
# pass on files git never saw (the i18n dictionaries were ignored by a global
# *.json rule and every Cloudflare deploy died for hours). git-archive gives
# exactly what CF will get; node_modules is shared for speed.
set -e
RANGE=$(git rev-parse @{push}..HEAD 2>/dev/null || echo HEAD~1..HEAD)
CHANGED=$(git diff --name-only ${RANGE} 2>/dev/null || git diff --name-only HEAD~1..HEAD)
if echo "$CHANGED" | grep -qE '^site/'; then
  echo "[pre-push] building the committed tree..."
  TMP=$(mktemp -d)
  trap "rm -rf $TMP" EXIT
  git archive HEAD site | tar -x -C "$TMP"
  ln -s "$(pwd)/site/node_modules" "$TMP/site/node_modules"
  (cd "$TMP/site" && npm run build > /tmp/prepush_build.log 2>&1) || {
    echo "[pre-push] COMMITTED-TREE BUILD FAILED — push blocked."
    grep -E "\[ERROR\]|Could not resolve" -A3 /tmp/prepush_build.log | head -12
    exit 1
  }
  BAD=0; N=0
  for f in "$TMP"/site/dist/**/*.html(N); do
    N=$((N+1)); [ "$(wc -c < $f)" -lt 2000 ] && { echo "[pre-push] EMPTY PAGE: $f"; BAD=1; }
  done
  [ $BAD -eq 1 ] && { echo "[pre-push] push blocked: empty pages"; exit 1; }
  /opt/anaconda3/bin/python - "$TMP" <<'PY' || exit 1
import json, sys
base = sys.argv[1] + '/site/src/i18n/'
def K(d,p=''):
    o=set()
    for k,v in d.items():
        o.add(p+k)
        if isinstance(v,dict): o|=K(v,p+k+'.')
    return o
e=json.load(open(base+'en.json')); u=json.load(open(base+'uk.json'))
assert K(e)==K(u), "[pre-push] i18n parity broken in COMMITTED files"
print(f"[pre-push] i18n parity OK ({len(K(e))} keys, committed)")
PY
  echo "[pre-push] committed tree: $N pages OK — pushing."
fi
exit 0
